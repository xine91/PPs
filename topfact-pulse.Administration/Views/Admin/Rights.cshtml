@{
    ViewData["Title"] = "Zugriffsrechte";
}

<text>
<!DOCTYPE html>
<html>
<head>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#ffffff;--bg2:#f5f5f5;--bg3:#ffffff;--bg4:#f0f0f0;
  --border:#e0e0e0;--border2:#d0d0d0;
  --text:#1a1a1a;--text2:#666666;--text3:#999999;
  --accent:#4a90e2;--accent2:#357abd;
  --red:#f54242;--orange:#f5a442;--green:#42c88c;
}
body{background:var(--bg);color:var(--text);font-family:'Geist',sans-serif;min-height:100vh}
.main{display:flex;flex-direction:column;min-height:100vh}
.topbar{display:flex;align-items:center;gap:16px;padding:16px 28px;border-bottom:1px solid var(--border)}
.admin-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;width:100%}
.topbar-actions{margin-left:auto;display:flex;gap:8px;align-items:center}
.btn{font-family:'Geist Mono',monospace;font-size:11px;font-weight:500;padding:7px 14px;border-radius:6px;cursor:pointer;border:1px solid var(--border2);background:#ffffff;color:var(--text2);transition:all .14s}
.btn:hover{border-color:var(--accent);color:var(--accent);background:#f9f9f9}
.btn-accent{background:var(--accent);color:#ffffff;border-color:transparent;font-weight:600}
.btn-accent:hover{opacity:0.9;background:#357abd}
.filterbar{display:flex;align-items:center;gap:10px;padding:14px 28px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.search-wrap{position:relative;flex:1;max-width:300px}
.search-inp{width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:7px 10px;font-family:'Geist Mono',monospace;font-size:11px;color:var(--text);outline:none}
.search-inp:focus{border-color:var(--border2)}
.filter-select{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:7px 10px;font-family:'Geist Mono',monospace;font-size:11px;color:var(--text2);outline:none;cursor:pointer}
.filter-select:focus{border-color:var(--border2)}
.filter-count{font-family:'Geist Mono',monospace;font-size:10px;color:var(--text3);margin-left:auto}
.table-wrap{flex:1;overflow:auto;padding:0 28px 28px}
table{width:100%;border-collapse:collapse;margin-top:16px}
thead th{font-family:'Geist Mono',monospace;font-size:10px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--text3);padding:8px 12px;text-align:left;border-bottom:1px solid var(--border)}
tbody tr{border-bottom:1px solid var(--border);cursor:pointer}
tbody tr:hover{background:var(--bg2)}
tbody td{padding:11px 12px;font-size:12px;color:#e0e0e0}

                    .td-mono {
                        font-family: 'Geist Mono',monospace;
                        font-size: 11px, color:#ffffff
                    }
.td-user{display:flex;align-items:center;gap:9px, color:#ffffff}
.user-avatar{width:26px;height:26px;border-radius:5px;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:500;color:var(--accent);flex-shrink:0}
.perm-badge{display:inline-flex;align-items:center;gap:4px;font-family:'Geist Mono',monospace;font-size:10px;font-weight:500;padding:3px 8px;border-radius:4px}
.perm-admin{background:rgba(245,66,66,.12);color:#f57070;border:1px solid rgba(245,66,66,.2)}
.perm-write{background:rgba(245,164,66,.12);color:#f5b85a;border:1px solid rgba(245,164,66,.2)}
.perm-read{background:rgba(66,200,140,.12);color:#5dd4a0;border:1px solid rgba(66,200,140,.2)}
.toggle{position:relative;width:32px;height:18px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.toggle-track{position:absolute;inset:0;background:var(--bg4);border:1px solid var(--border2);border-radius:99px;cursor:pointer}
.toggle input:checked~.toggle-track{background:var(--accent);border-color:var(--accent)}
.toggle-thumb{position:absolute;top:2px;left:2px;width:12px;height:12px;background:var(--text3);border-radius:50%;pointer-events:none}
.toggle input:checked~.toggle-track .toggle-thumb{transform:translateX(14px);background:var(--bg)}
.row-actions{display:flex;gap:6px;opacity:0}
tr:hover .row-actions{opacity:1}
.row-btn{background:var(--bg4);border:1px solid var(--border);border-radius:4px;padding:4px 8px;font-family:'Geist Mono',monospace;font-size:10px;color:var(--text2);cursor:pointer}
.row-btn:hover{border-color:var(--accent);color:var(--accent)}
.row-btn.del:hover{border-color:var(--red);color:var(--red)}
.drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;display:none}
.drawer-overlay.open{display:flex;align-items:flex-start;justify-content:flex-end}
.drawer{width:380px;height:100vh;background:#f9f9f9;border-left:1px solid var(--border);display:flex;flex-direction:column}
.drawer-head{padding:18px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.drawer-title{font-family:'Geist Mono',monospace;font-size:13px;font-weight:500}
.drawer-close{margin-left:auto;background:none;border:none;cursor:pointer;color:var(--text3);font-size:18px;padding:2px}
.drawer-body{flex:1;padding:20px;overflow-y:auto}
.dfield{margin-bottom:16px}
.dfield label{font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--text3);display:block;margin-bottom:5px}
.dfield input,.dfield select{width:100%;background:#ffffff;border:1px solid var(--border);border-radius:6px;padding:8px 10px;font-family:'Geist Mono',monospace;font-size:12px;color:var(--text);outline:none}
.dfield input:focus,.dfield select:focus{border-color:var(--border2)}
.perm-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.perm-option{border:1px solid var(--border);border-radius:6px;padding:10px 12px;cursor:pointer}
.perm-option:hover{border-color:var(--border2)}
.perm-option.selected{border-color:var(--accent);background:rgba(200,245,66,.06)}
.perm-option-label{font-family:'Geist Mono',monospace;font-size:11px;font-weight:500;color:var(--text)}
.perm-option-desc{font-size:10px;color:var(--text3);margin-top:2px}
.drawer-foot{padding:16px 20px;border-top:1px solid var(--border);display:flex;gap:8px}
.dsec{font-family:'Geist Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#ffffff;margin-bottom:10px;margin-top:4px;font-weight:600}
.dsec-text{font-family:'Geist Mono',monospace;font-size:9px;letter-spacing:.1em;color:#ffffff;margin-bottom:10px;margin-top:4px;font-weight:600}
.admin-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem}
.admin-header h1{font-size:1.4rem;font-weight:700;margin:0;display:flex;align-items:center;gap:8px;color:var(--text)}
.admin-header p{margin:0;font-size:0.85rem;color:var(--text3)}
/* Dark Theme */
[data-pulse-theme=dark] .admin-header h1{color:#e6edf3}
[data-pulse-theme=dark] .admin-header p{color:#6e7681}
</style>
</head>
<body>

<div class="main">
  <div class="topbar">
    <div class="admin-header">
      <div>
        <h1><i class="ri-settings-3-line" style="color:var(--accent)"></i> Zugriffsrechte</h1>
        <p>Bereichs- und Gruppenberechtigungen verwalten</p>
      </div>
      <div class="topbar-actions">
        <button class="btn" onclick="exportCSV()">Export CSV</button>
        <button class="btn btn-accent" onclick="openDrawer(null)">+ Eintrag</button>
      </div>
    </div>
  </div>

  <div class="filterbar">
    <input class="search-inp" placeholder="Suchen…" oninput="filterTable(this.value)" style="flex:1;max-width:300px">
    <select class="filter-select" onchange="filterByPerm(this.value)">
      <option value="">Alle Permissions</option>
      <option value="Admin">Admin</option>
      <option value="Edit">Edit</option>
      <option value="View">View</option>
    </select>
    <select class="filter-select" onchange="filterByActive(this.value)">
      <option value="">Alle Status</option>
      <option value="1">Aktiv</option>
      <option value="0">Inaktiv</option>
    </select>
    <span class="filter-count" id="rowCount">0 Einträge</span>
  </div>

  <div class="table-wrap">
    <table id="mainTable">
      <thead>
        <tr>
          <th>Benutzer</th>
          <th>Bereich</th>
          <th>Gruppe</th>
          <th>Permission</th>
          <th>Status</th>
          <th>Bearbeitet von</th>
          <th>Aktionen</th>
        </tr>
      </thead>
      <tbody id="tableBody"></tbody>
    </table>
  </div>
</div>

<div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer(event)">
  <div class="drawer" onclick="event.stopPropagation()">
    <div class="drawer-head">
      <div class="drawer-title" id="drawerTitle">Berechtigung</div>
      <button class="drawer-close" onclick="closeDrawer()">×</button>
    </div>
    <div class="drawer-body">
      <div class="dsec">Benutzer</div>
      <div class="dfield"><label>Username</label><input id="d-user" placeholder="Benutzer"></div>
      <div class="dsec" style="margin-top:16px">Zuordnung</div>
      <div class="dfield"><label>BereichID</label><select id="d-bereich"><option>--</option></select></div>
      <div class="dfield"><label>GruppeID</label><select id="d-gruppe"><option>--</option></select></div>
      <div class="dsec" style="margin-top:16px">Permission</div>
      <div class="perm-grid">
        <div class="perm-option" onclick="selectPerm(this,'Admin')"><div class="perm-option-label" style="color:#f57070">Admin</div></div>
        <div class="perm-option selected" onclick="selectPerm(this,'Edit')"><div class="perm-option-label" style="color:#f5b85a">Edit</div></div>
        <div class="perm-option" onclick="selectPerm(this,'View')"><div class="perm-option-label" style="color:#5dd4a0">View</div></div>
      </div>
      <div class="dsec" style="margin-top:16px">Status</div>
      <div class="dfield" style="display:flex;align-items:center;gap:10px">
        <label class="toggle"><input type="checkbox" id="d-active" checked><div class="toggle-track"><div class="toggle-thumb"></div></div></label>
        <span style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--text2)">Aktiv</span>
      </div>
    </div>
    <div class="drawer-foot">
      <button class="btn btn-accent" onclick="saveRow()">Speichern</button>
      <button class="btn" onclick="closeDrawer()">Abbrechen</button>
    </div>
  </div>
</div>

<script>
let allAccess = @Html.Raw(Json.Serialize(ViewBag.AccessList ?? new List<object>()));
let filteredData = allAccess ? [...allAccess] : [];
let editId = null, selPerm = 'Edit';
let bereiche = [], gruppen = [];

function cmShowToast(message) {
  const toast = document.createElement('div');
  toast.textContent = message;
  toast.style.cssText = 'position:fixed;top:20px;right:20px;background:#4a90e2;color:#fff;padding:12px 20px;border-radius:6px;font-family:monospace;z-index:1000;';
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 2500);
}

// Lade Bereiche und Gruppen
async function loadOptions() {
  try {
    const [bRes, gRes] = await Promise.all([
      fetch('/admin/bereiche').then(r => r.json()),
      fetch('/admin/gruppen').then(r => r.json())
    ]);
    bereiche = bRes || [];
    gruppen = gRes || [];
    populateSelects();
  } catch (e) {
    console.error('Fehler beim Laden der Optionen:', e);
  }
}

function populateSelects() {
  const bereichSel = document.getElementById('d-bereich');
  const gruppeSel = document.getElementById('d-gruppe');

  bereichSel.innerHTML = '<option value="">-- Alle --</option>' + 
    bereiche.map(b => `<option value="${b.bereichID}">${b.displayName}</option>`).join('');

  gruppeSel.innerHTML = '<option value="">-- Alle --</option>' + 
    gruppen.map(g => `<option value="${g.gruppeID}">${g.displayName}</option>`).join('');
}

function permClass(p) { return p === 'Admin' ? 'perm-admin' : p === 'Edit' ? 'perm-write' : 'perm-read'; }
function initials(u) { return u.split('.').map(p => p[0].toUpperCase()).join(''); }

function render(data) {
  const tb = document.getElementById('tableBody');
  tb.innerHTML = data.map(u => `
    <tr onclick="openDrawer(${u.id})">
      <td><div class="td-user"><div class="user-avatar">${initials(u.username)}</div><div>${u.username}</div></div></td>
      <td class="td-mono">${u.bereichName || '-'}</td>
      <td class="td-mono">${u.gruppeName || '-'}</td>
      <td><span class="perm-badge ${permClass(u.permission)}">${u.permission}</span></td>
      <td><label class="toggle" onclick="event.stopPropagation()"><input type="checkbox" ${u.isActive ? 'checked' : ''} onchange="toggleActive(${u.id})"><div class="toggle-track"><div class="toggle-thumb"></div></div></label></td>
      <td class="td-mono">${u.updatedBy || '-'}</td>
      <td><div class="row-actions"><button class="row-btn" onclick="event.stopPropagation();openDrawer(${u.id})">Edit</button><button class="row-btn del" onclick="event.stopPropagation();deleteRow(${u.id})">Del</button></div></td>
    </tr>`).join('');
  document.getElementById('rowCount').textContent = data.length + ' Einträge';
}

function filterTable(v) {
  const f = v.toLowerCase();
  filteredData = allAccess.filter(u => u.username.toLowerCase().includes(f));
  render(filteredData);
}

function filterByPerm(v) {
  filteredData = v ? allAccess.filter(u => u.permission === v) : [...allAccess];
  render(filteredData);
}

function filterByActive(v) {
  filteredData = v === '' ? [...allAccess] : allAccess.filter(u => u.isActive === (v === '1'));
  render(filteredData);
}

function toggleActive(id) {
  const u = allAccess.find(x => x.id === id);
  if (u) {
    u.isActive = !u.isActive;
    fetch(`/admin/access/${id}`, { 
      method: 'PUT', 
      headers: { 'Content-Type': 'application/json' }, 
      body: JSON.stringify(u) 
    })
    .then(() => {
      cmShowToast('Status gespeichert ✓');
      setTimeout(() => location.reload(), 500);
    })
    .catch(e => { alert('Fehler beim Speichern: ' + e.message); });
  }
}

function deleteRow(id) {
  if (!confirm('Wirklich löschen?')) return;
  fetch(`/admin/access/${id}`, { method: 'DELETE' })
    .then(() => {
      allAccess = allAccess.filter(x => x.id !== id);
      filteredData = filteredData.filter(x => x.id !== id);
      cmShowToast('Gelöscht ✓');
      setTimeout(() => location.reload(), 500);
    })
    .catch(e => { alert('Fehler beim Löschen: ' + e.message); });
}

function openDrawer(id) {
  editId = id;
  document.getElementById('drawerOverlay').classList.add('open');
  if (id) {
    const u = allAccess.find(x => x.id === id);
    document.getElementById('drawerTitle').textContent = 'Berechtigung bearbeiten';
    document.getElementById('d-user').value = u.username;
    document.getElementById('d-bereich').value = u.bereichID || '';
    document.getElementById('d-gruppe').value = u.gruppeID || '';
    document.getElementById('d-active').checked = u.isActive;
    selPerm = u.permission;
    document.querySelectorAll('.perm-option').forEach(o => o.classList.remove('selected'));
    document.querySelectorAll('.perm-option').forEach(o => {
      if (o.textContent.includes(selPerm)) o.classList.add('selected');
    });
  } else {
    document.getElementById('drawerTitle').textContent = 'Neue Berechtigung';
    document.getElementById('d-user').value = '';
    document.getElementById('d-bereich').value = '';
    document.getElementById('d-gruppe').value = '';
    document.getElementById('d-active').checked = true;
    selPerm = 'Edit';
    document.querySelectorAll('.perm-option').forEach(o => o.classList.remove('selected'));
    document.querySelectorAll('.perm-option').forEach((o, i) => { if (i === 1) o.classList.add('selected'); });
  }
}

function closeDrawer(e) {
  if (!e || e.target === document.getElementById('drawerOverlay'))
    document.getElementById('drawerOverlay').classList.remove('open');
}

function selectPerm(el, p) {
  selPerm = p;
  document.querySelectorAll('.perm-option').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
}

function saveRow() {
  const username = document.getElementById('d-user').value;
  if (!username) { alert('Username erforderlich'); return; }

  const bereich = parseInt(document.getElementById('d-bereich').value) || null;
  const gruppe = parseInt(document.getElementById('d-gruppe').value) || null;

  const u = {
    username: username,
    bereichID: bereich,
    gruppeID: gruppe,
    permission: selPerm,
    isActive: document.getElementById('d-active').checked
  };
  const method = editId ? 'PUT' : 'POST';
  const url = editId ? `/admin/access/${editId}` : `/admin/access`;
  fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(u) })
    .then(r => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.text().then(text => text ? JSON.parse(text) : {});
    })
    .then(data => {
      cmShowToast('Gespeichert ✓');
      document.getElementById('drawerOverlay').classList.remove('open');
      setTimeout(() => location.reload(), 500);
    })
    .catch(e => { alert('Fehler beim Speichern: ' + e.message); });
}

function exportCSV() {
  const csv = [['Benutzer', 'Bereich', 'Gruppe', 'Permission', 'Status', 'Bearbeitet von'],
    ...allAccess.map(u => [u.username, u.bereichName || '-', u.gruppeName || '-', u.permission, u.isActive ? 'Aktiv' : 'Inaktiv', u.updatedBy || '-'])
  ].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'rechte.csv';
  a.click();
}

render(filteredData);
loadOptions();
</script>

</body>
</html>
</text>
