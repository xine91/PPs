// ── Validate SQL Query ──
function validateSqlQuery(sqlQuery) {
  if (!sqlQuery) return true; // Leere Queries sind OK

  return true;
}

async function executeSqlQuery(editorKey) {
  // Finde das Textarea-Element
  const editor = document.getElementById('ed-' + editorKey);
  if (!editor) {
    showToast('Editor nicht gefunden');
    return;
  }

  const textarea = editor.querySelector('textarea[name="sql_query"]');
  if (!textarea) {
    showToast('SQL-Query Feld nicht gefunden');
    return;
  }

  const sqlQuery = textarea.value.trim();

  if (!sqlQuery) {
    showToast('Bitte geben Sie eine SQL-Query ein');
    return;
  }

  if (!validateSqlQuery(sqlQuery)) {
    return;
  }

  // Hole die ausgewählte Connector-ID
  const connectorSelect = editor.querySelector('select[name="connectorId"]');
  const connectorId = connectorSelect ? connectorSelect.value : '';

  try {
    showToast('Query wird ausgeführt...');

    const response = await fetch('/Home/ExecuteKategorieSqlQuery', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
      },
      body: JSON.stringify({ sqlQuery: sqlQuery, kategorieID: parseInt(editorKey.split('-')[1]), connectorID: connectorId ? parseInt(connectorId) : null })
    });

    const data = await response.json();

    if (response.ok && data.success) {
      showToast(`✓ ${data.message}`);
    } else {
      showToast(`✕ Fehler: ${data.error || 'Unbekannter Fehler'}`);
    }
  } catch (error) {
    showToast('Fehler bei der Query-Ausführung: ' + error.message);
  }
}

async function submitKategorie(event, id) {
  event.preventDefault();
  const formData = new FormData(event.target);
  const sqlQuery = formData.get('sql_query') || '';
  const connectorId = formData.get('connectorId');

  if (!validateSqlQuery(sqlQuery)) {
    return;
  }

  const form = new FormData();
  form.append('KategorieForm.KategorieID', id.toString());
  form.append('KategorieForm.GruppeID', formData.get('gruppeId'));
  form.append('KategorieForm.Title', formData.get('title'));
  form.append('KategorieForm.SortOrder', formData.get('sortOrder') || '0');
  form.append('KategorieForm.IconCss', formData.get('iconCss') || '');
  form.append('KategorieForm.Sql_query', sqlQuery);
  if (connectorId) {
    form.append('KategorieForm.ConnectorID', connectorId);
  }
  await submitToServer('SaveKategorie', form);
}

async function submitToServer(action, formData) {
  try {
    // Hole CSRF-Token
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    if(token) {
      formData.append('__RequestVerificationToken', token);
    }

    const response = await fetch(`/Home/${action}`, {
      method: 'POST',
      body: formData
    });

    let data;
    try {
      data = await response.json();
    } catch (e) {
      // Fallback wenn Response kein JSON ist
      data = { success: false, error: `HTTP ${response.status}` };
    }

    if(data.success) {
      showToast('✓ ' + (data.message || 'Erfolgreich gespeichert'));
      setTimeout(() => {
        window.location.reload();
      }, 800);
    } else {
      showToast('✕ ' + (data.error || 'Fehler beim Speichern'));
    }
  } catch(e) {
    showToast('Fehler beim Speichern: ' + e.message);
  }
}

// ── Toggle editor ──
function toggleEditor(key) {
  if(openEditors.has(key)) openEditors.delete(key);
  else openEditors.add(key);
  const el = document.getElementById('ed-'+key);
  const entry = document.getElementById('ie-'+key);
  if(el) el.classList.toggle('show', openEditors.has(key));
  if(entry) entry.classList.toggle('is-open', openEditors.has(key));
}

// ── Delete ──
let pendingDelete = null;

function showDeleteConfirm(key) {
  // Extrahiere Typ und ID aus dem Key (z.B. "bereich-5" -> "bereich", "5")
  const [type, id] = key.split('-');
  const editorKey = `${type}-${id}`;

  // Öffne den Editor, falls nicht geöffnet
  if(!openEditors.has(editorKey)) {
    openEditors.add(editorKey);
    const el = document.getElementById('ed-' + editorKey);
    const entry = document.getElementById('ie-' + editorKey);
    if(el) el.classList.add('show');
    if(entry) entry.classList.add('is-open');
  }

  // Scrolle zum Editor
  setTimeout(() => {
    const editorEl = document.getElementById('ed-' + editorKey);
    if(editorEl) {
      editorEl.scrollIntoView({behavior: 'smooth', block: 'nearest'});
    }
  }, 50);

  // Schließe alle offenen Bestätigungspanel
  document.querySelectorAll('.delete-confirm.show').forEach(el => el.classList.remove('show'));

  // Öffne das entsprechende Panel
  const confirmPanel = document.getElementById('dc-' + key);
  if(confirmPanel) {
    confirmPanel.classList.add('show');
  }
}

function hideDeleteConfirm(key) {
  const confirmPanel = document.getElementById('dc-' + key);
  if(confirmPanel) {
    confirmPanel.classList.remove('show');
  }
}

async function deleteItem(key) {
  // Key format: "type-id" z.B. "bereich-5", "gruppe-3", "kategorie-12"
  const [type, id] = key.split('-');
  const formData = new FormData();

  if(type === 'bereich') {
    formData.append('bereichId', id);
  } else if(type === 'gruppe') {
    formData.append('gruppeId', id);
  } else if(type === 'kategorie') {
    formData.append('kategorieId', id);
  }

  await submitToServer(`Delete${type.charAt(0).toUpperCase() + type.slice(1)}`, formData);
  hideDeleteConfirm(key);
}

function confirmDelete(type, id, name) {
  const typeLabel = {bereich:'Bereich',gruppe:'Gruppe',kategorie:'Kategorie'}[type];
  let warning = '';
  if(type==='bereich') {
    const gruppen = data.gruppen.filter(g=>g.bereichId===id);
    if(gruppen.length) warning = ` Dieser Bereich enthält ${gruppen.length} Gruppe(n). Alle untergeordneten Einträge werden ebenfalls gelöscht.`;
  }
  if(type==='gruppe') {
    const kategorien = data.kategorien.filter(k=>k.gruppeId===id);
    if(kategorien.length) warning = ` Diese Gruppe enthält ${kategorien.length} Kategorie(n). Diese werden ebenfalls gelöscht.`;
  }

  pendingDelete = {type, id, name};
}

// ── Toast ──
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2200);
}

// ── Utils ──
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// ── Init ──
if(document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', async function() {
    await loadConnectors();
    render();
  });
} else {
  // DOM ist bereits geladen
  loadConnectors().then(() => render());
}
