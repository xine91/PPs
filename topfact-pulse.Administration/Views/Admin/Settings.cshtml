  const connectorId = formData.get('connectorId');

  if (!validateSqlQuery(sqlQuery)) {
    return;
  }

  const form = new FormData();
  form.append('KategorieForm.KategorieID', '0');
  form.append('KategorieForm.GruppeID', formData.get('gruppeId'));
  form.append('KategorieForm.Title', formData.get('title'));
  form.append('KategorieForm.SortOrder', formData.get('sortOrder') || '0');
  form.append('KategorieForm.IconCss', formData.get('iconCss') || '');
  form.append('KategorieForm.Sql_query', sqlQuery);
  if (connectorId) {
    form.append('KategorieForm.ConnectorID', connectorId);
  }

  await submitToServer('SaveKategorie', form);
}

