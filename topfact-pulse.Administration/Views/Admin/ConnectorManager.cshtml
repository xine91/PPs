// ── Datenquellen laden und anzeigen ──
async function cmLoadDataSources() {
  try {
    const response = await fetch(`${baseUrl}/admin/datasources`);
    if (!response.ok) throw new Error('Fehler beim Laden der Datenquellen');

    const dataSources = await response.json();
    const list = document.getElementById('cmDataSourcesList');

    if (dataSources.length === 0) {
      list.innerHTML = '';
      return;
    }

    // Filter: Nur sql-user und api-user anzeigen
    const filteredSources = dataSources.filter(ds => 
      ds.connectorType === 'api-user' || ds.connectorType === 'sql-user'
    );

    list.innerHTML = filteredSources.map(ds => {
      const icoClass = ds.connectorType === 'api-user' ? 'ti-api' : 'ti-database';
      const displayName = ds.connectorType === 'api-user' ? 'API' : 'DB';
      const dsId = `ds-${ds.id}`;

      return `
        <button class="cm-ds-item" onclick="cmPick('${dsId}', this)" data-ds-id="${ds.id}">
          <div class="cm-ds-item-info">
            <div class="cm-ds-item-ico"><i class="ti ${icoClass}" aria-hidden="true"></i></div>
            <div class="cm-ds-item-text">
              <div class="cm-ds-item-name">${displayName}</div>
              <div class="cm-ds-item-type">${ds.connectorType}</div>
            </div>
          </div>
        </button>
      `;
    }).join('');
  } catch (e) {
    // Fehler beim Laden - zeige leere Liste
    const list = document.getElementById('cmDataSourcesList');
    list.innerHTML = '';
  }
}

async function cmDeleteDataSourceConfirm(id, event) {
  event.stopPropagation();
  if (!confirm('Möchten Sie diese Datenquelle wirklich löschen?')) {
    return;
  }

  try {
    const response = await fetch(`/admin/datasource/${id}`, {
      method: 'DELETE'
    });

    if (response.ok) {
      cmShowToast('✓ Datenquelle gelöscht');
      cmLoadDataSources();
    } else {
      const error = await response.json();
      cmShowToast(`✕ Fehler: ${error.error || 'Löschen fehlgeschlagen'}`);
    }
  } catch (e) {
    cmShowToast(`✕ Fehler: ${e.message}`);
  }
}

// ── Neue Datenquelle erstellen ──
function cmOpenAddDataSourceModal() {
  const modal = document.getElementById('cmAddDataSourceModal');
  if (modal) modal.style.display = 'flex';
}

function cmCloseAddDataSourceModal() {
  const modal = document.getElementById('cmAddDataSourceModal');
  if (modal) modal.style.display = 'none';
}

async function cmCreateNewDataSource(type) {
  try {
    const name = prompt(`Name für neue ${type === 'api' ? 'API' : 'Datenbank'} Datenquelle:`);
    if (!name || name.trim() === '') {
      cmShowToast('✕ Name erforderlich');
      return;
    }

    const response = await fetch('/admin/datasource/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: name.trim(),
        type: type
      })
    });

    if (response.ok) {
      const result = await response.json();
      cmShowToast(`✓ Neue ${type === 'api' ? 'API' : 'DB'} Datenquelle erstellt`);
      cmCloseAddDataSourceModal();
      cmLoadDataSources();
    } else {
      const error = await response.json();
      cmShowToast(`✕ Fehler: ${error.error || 'Speichern fehlgeschlagen'}`);
    }
  } catch (e) {
    cmShowToast(`✕ Fehler: ${e.message}`);
  }
}

