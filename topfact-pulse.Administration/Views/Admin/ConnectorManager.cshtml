<script>
    const baseUrl = '@Url.Content("~/")'.replace(/\/$/, '');
const cmMeta = {
  api: {
    ico: 'ico-api',
    icoClass: 'ti-api',
    title: 'Irgendeine API',
    sub: 'HTTP-Schnittstelle · GET/POST',
    badge: 'warn',
    badgeTxt: 'konfigurieren'
  },
  manual: {
    ico: 'ico-man',
    icoClass: 'ti-pencil',
    title: 'Manuell / Input',
    sub: 'Direkteingabe · Formular',
    badge: 'ok',
    badgeTxt: 'aktiv'
  }
};

let cmCur = null;

async function cmPick(id, el) {
  cmCur = id;
  document.querySelectorAll('.cm-conn-item, .cm-ds-item').forEach(s => s.classList.remove('active'));
  el.classList.add('active');

  const m = cmMeta[id];
  if (m) {
    const mico = document.getElementById('cm-ico');
    mico.className = 'cm-header-ico ' + m.ico;
    mico.innerHTML = `<i class="ti ${m.icoClass}" aria-hidden="true"></i>`;
    document.getElementById('cm-title').textContent = m.title;
    document.getElementById('cm-sub').textContent = m.sub;
    const badge = document.getElementById('cm-badge');
    badge.className = 'cm-badge ' + m.badge;
    badge.textContent = m.badgeTxt;
  } else {
    // Für Datenquellen ohne cmMeta-Eintrag
    const mico = document.getElementById('cm-ico');
    const titleEl = el.querySelector('.cm-ds-item-name');
    const typeEl = el.querySelector('.cm-ds-item-type');

    if (typeEl && typeEl.textContent.includes('api-user')) {
      mico.className = 'cm-header-ico ico-api';
      mico.innerHTML = '<i class="ti ti-api" aria-hidden="true"></i>';
    } else if (typeEl && typeEl.textContent.includes('sql-user')) {
      mico.className = 'cm-header-ico ico-sql';
      mico.innerHTML = '<i class="ti ti-database" aria-hidden="true"></i>';
    }

    document.getElementById('cm-title').textContent = titleEl ? titleEl.textContent : 'Datenquelle';
    document.getElementById('cm-sub').textContent = typeEl ? typeEl.textContent : '';
    const badge = document.getElementById('cm-badge');
    badge.className = 'cm-badge warn';
    badge.textContent = 'konfigurieren';
  }

  const activeTab = document.querySelector('.cm-tab.active').getAttribute('data-id') || 'overview';

  // ZEIGE die View ZUERST, um die HTML zu erstellen
  cmShowView(id, activeTab);

  // DANN lade die Daten, um die Elemente zu füllen
  if (id.startsWith('ds-')) {
    await loadDataSourceConfig(id);
  } else {
    await loadConnectorData(id);
  }
}

function cmSwTab(id, el) {
  document.querySelectorAll('.cm-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  el.setAttribute('data-id', id);
  document.querySelectorAll('.cm-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('cm-tab-' + id).classList.add('active');

  // Zeige die View auf dem neuen Tab an
  cmShowView(cmCur, id);
}

function cmShowView(connId, tabId) {
  const prefix = tabId === 'overview' ? 'cm-ov' : 'cm-cfg';
  document.querySelectorAll(`#cm-tab-${tabId} .cm-view`).forEach(v => v.classList.remove('active'));

  let v = document.getElementById(prefix + '-' + connId);

  // Für Datenquellen (ds-{id}): dynamisch View erzeugen, falls nicht vorhanden
  if (connId.startsWith('ds-') && !v) {
    const panel = document.getElementById('cm-tab-' + tabId);
    if (panel) {
      const dsId = connId.replace('ds-', '');
      let viewHtml = '';

      if (tabId === 'overview') {
        viewHtml = `
          <div class="cm-view" id="cm-ov-${connId}">
            <div class="cm-sec">
              <div class="cm-sec-title">Allgemein</div>
              <div class="cm-field"><label>Bezeichnung</label><input name="bezeichnung" value="" /></div>
              <div class="cm-field"><label>Status</label><input name="status" readonly value="" /></div>
            </div>
            <div class="cm-foot">
              <button class="cm-btn cm-btn-primary" onclick="cmSaveConnector('${connId}')">Speichern</button>
              <button class="cm-btn" onclick="cmTestConnection('${connId}')">Verbindung testen</button>
              <button class="cm-btn cm-btn-danger" onclick="cmDeleteDataSourceConfirm(${dsId}, event)">Löschen</button>
            </div>
          </div>
        `;
      } else {
        // Config View
        viewHtml = `
          <div class="cm-view" id="cm-cfg-${connId}">
            <div class="cm-sec">
              <div class="cm-sec-title">Konfiguration</div>
              <div class="cm-field"><label>Verbindungstyp</label><input readonly name="type" value="" /></div>
            </div>
            <div id="cm-ds-config-fields-${dsId}">
              <!-- Wird von loadDataSourceConfig() gefüllt -->
            </div>
            <div class="cm-foot">
              <button class="cm-btn cm-btn-primary" onclick="cmSaveConnector('${connId}')">Speichern</button>
              <button class="cm-btn" onclick="cmTestConnection('${connId}')">Verbindung testen</button>
            </div>
          </div>
        `;
      }

      panel.insertAdjacentHTML('beforeend', viewHtml);
      v = document.getElementById(prefix + '-' + connId);
    }
  }

  if (v) v.classList.add('active');
}

function cmSg(el) {
  el.closest('.cm-seg').querySelectorAll('.cm-seg-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
}

function cmAu(el) {
  el.closest('.cm-seg').querySelectorAll('.cm-seg-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  const d = document.getElementById('cm-api-auth-dyn');
  const t = el.textContent.trim();
  if (t === 'Bearer Token') {
    d.innerHTML = '<div class="cm-field"><label>Token</label><input name="token" placeholder="Bearer eyJhbGciOiJIUzI1NiJ9…"></div>';
  } else if (t === 'Basic Auth') {
    d.innerHTML = '<div class="cm-fields-2"><div class="cm-field"><label>Username</label><input name="username"></div><div class="cm-field"><label>Password</label><input name="password" type="password" placeholder="••••••••"></div></div>';
  } else {
    d.innerHTML = '';
  }
}

function cmAddHdr(listId) {
  const r = document.createElement('div');
  r.className = 'cm-hrow';
  r.innerHTML = '<input name="headerKey" placeholder="Key"><input name="headerValue" placeholder="Value"><button class="cm-del-btn" onclick="this.closest(\'.cm-hrow\').remove()">×</button>';
  document.getElementById(listId).appendChild(r);
}

// ── API Functions ──
async function cmSaveConnector(connId) {
  try {
    const config = {};
    const metaData = {};
    const panel = document.getElementById(`cm-cfg-${connId}`);
    const overviewPanel = document.getElementById(`cm-ov-${connId}`);

    // Sammle Bezeichnung und Status aus dem Overview-Panel (NICHT in config!)
    if (overviewPanel) {
      const ovBez = overviewPanel.querySelector('input[name="bezeichnung"]');
      const ovStatus = overviewPanel.querySelector('input[name="status"]');
      if (ovBez?.value) metaData['bezeichnung'] = ovBez.value;
      if (ovStatus?.value) metaData['status'] = ovStatus.value;
      // kategorieID wird NICHT hier gesetzt - wird später über Settings.cshtml zugewiesen
    }

    // Sammle alle benannten Input-Felder aus dem Config-Panel
    // ABER NICHT "bezeichnung", "status", "kategorieID", "headerKey", "headerValue"!
    if (panel) {
      panel.querySelectorAll('input[name], textarea[name], select[name]').forEach(el => {
        const value = el.value || '';
        const name = el.name;
        // Ignoriere bezeichnung, status, kategorieID und Custom Header Keys/Values
        if (value && name !== 'bezeichnung' && name !== 'status' && name !== 'kategorieID' && name !== 'headerKey' && name !== 'headerValue') {
          config[name] = value;
        }
      });
    }

    // Für API: HTTP Methode, Auth Type und Custom Headers
    if (connId === 'api') {
      const activeMethod = panel?.querySelector('#cm-cfg-api .cm-seg:first-of-type .cm-seg-btn.active');
      if (activeMethod) config['httpMethod'] = activeMethod.textContent.trim();

      const activeAuth = panel?.querySelector('#cm-cfg-api .cm-seg:last-of-type .cm-seg-btn.active');
      if (activeAuth) config['authType'] = activeAuth.textContent.trim();

      // Custom Headers sammeln
      const headers = {};
      const hdrContainer = panel?.querySelector('#cm-api-hdr-list');
      if (hdrContainer) {
        hdrContainer.querySelectorAll('.cm-hrow').forEach(row => {
          const keyInput = row.querySelector('input[name="headerKey"]');
          const valInput = row.querySelector('input[name="headerValue"]');
          if (keyInput?.value && valInput?.value) {
            headers[keyInput.value] = valInput.value;
          }
        });
      }
      if (Object.keys(headers).length > 0) {
        config['customHeaders'] = headers;
      }
    }

    // Für Manual: Pflichtfelder Button
    if (connId === 'manual') {
      const activeRequired = panel?.querySelector('.cm-field:nth-child(3) .cm-seg-btn.active');
      if (activeRequired) config['requiredFields'] = activeRequired.textContent.trim();
    }

    // Für Datenquellen: speichere über DQ-spezifischen Endpunkt
    if (connId.startsWith('ds-')) {
      const dsId = connId.replace('ds-', '');

      // Für API-User: Sammle auch HTTP Methode, Auth Type und Custom Headers
      const connectorTypeInput = panel?.querySelector('input[name="type"]');
      if (connectorTypeInput && connectorTypeInput.value === 'API') {
        const activeMethod = panel?.querySelector('.cm-seg:first-of-type .cm-seg-btn.active');
        if (activeMethod) config['httpMethod'] = activeMethod.textContent.trim();

        const activeAuth = panel?.querySelector('.cm-seg:nth-of-type(2) .cm-seg-btn.active');
        if (activeAuth) config['authType'] = activeAuth.textContent.trim();

        // Custom Headers sammeln (NICHT aus config, Duplikate vermeiden)
        const headers = {};
        const hdrListId = `cm-ds-hdr-list-${dsId}`;
        const hdrContainer = document.getElementById(hdrListId);
        if (hdrContainer) {
          hdrContainer.querySelectorAll('.cm-hrow').forEach(row => {
            const keyInput = row.querySelector('input[name="headerKey"]');
            const valInput = row.querySelector('input[name="headerValue"]');
            if (keyInput?.value && valInput?.value) {
              headers[keyInput.value] = valInput.value;
            }
          });
          if (Object.keys(headers).length > 0) {
            config['customHeaders'] = headers;
          }
        }
      }

      // Für Datenquellen: sende metaData als separate Felder
      const payload = { ...metaData, ...config };
      const response = await fetch(`/admin/datasource/${dsId}/config`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      cmShowToast(response.ok ? `✓ Datenquelle gespeichert` : `✕ Fehler beim Speichern`);
    } else {
      // Für ursprüngliche Connectoren: sende metaData als separate Felder
      const payload = { ...metaData, ...config };
      const response = await fetch(`${baseUrl}/admin/connector/${connId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      cmShowToast(response.ok ? `✓ ${connId} gespeichert` : `✕ Fehler beim Speichern`);
    }
  } catch (e) {
    cmShowToast(`✕ Fehler: ${e.message}`);
  }
}

async function cmTestConnection(connId) {
  try {
    let url;
    if (connId.startsWith('ds-')) {
      const dsId = connId.replace('ds-', '');
      url = `${baseUrl}/admin/datasource/${dsId}/test`;
    } else {
      url = `${baseUrl}/admin/connector/${connId}/test`;
    }

    cmShowToast('⏳ Verbindung wird getestet...');

    const response = await fetch(url, {
      method: 'POST'
    });

    const result = await response.json();

    // Benutze bessere Toast-Meldung
    if (result.success) {
      cmShowToast(`✓ ${result.message || 'Verbindung erfolgreich'}`, 'success');
    } else {
      cmShowToast(`✕ ${result.message || result.error || 'Verbindung fehlgeschlagen'}`, 'error');
    }
  } catch (e) {
    cmShowToast(`✕ Fehler: ${e.message}`, 'error');
  }
}

// ── Load Initial Data ──
async function loadConnectorData(connId) {
  try {
    const response = await fetch(`${baseUrl}/admin/connector/${connId}`);
    if (response.ok) {
      const config = await response.json();
      const panel = document.getElementById(`cm-cfg-${connId}`);
      const overviewPanel = document.getElementById(`cm-ov-${connId}`);

      // Lade Bezeichnung und Status ins Overview-Panel
      if (overviewPanel) {
        const bezInput = overviewPanel.querySelector('input[name="bezeichnung"]');
        const statusInput = overviewPanel.querySelector('input[name="status"]');
        if (bezInput && config.bezeichnung) bezInput.value = config.bezeichnung;
        if (statusInput && config.status) statusInput.value = config.status;
      }

      // Fülle alle benannten Felder (aber NICHT bezeichnung, status)
      for (const [key, value] of Object.entries(config)) {
        if (key === 'customHeaders' || key === 'requiredFields' || key === 'bezeichnung' || key === 'status' || key === 'kategorieID') continue; // Special handling
        const input = panel.querySelector(`[name="${key}"]`);
        if (input && value) {
          input.value = value;
        }
      }

      // Für API: Setze httpMethod und authType Button
      if (connId === 'api') {
        // HTTP Method
        if (config['httpMethod']) {
          const methodBtn = Array.from(panel.querySelectorAll('.cm-seg:first-of-type .cm-seg-btn'))
            .find(btn => btn.textContent.trim() === config['httpMethod']);
          if (methodBtn) methodBtn.click();
        }

        // Auth Type
        if (config['authType']) {
          const authBtn = Array.from(panel.querySelectorAll('.cm-seg:last-of-type .cm-seg-btn'))
            .find(btn => btn.textContent.trim() === config['authType']);
          if (authBtn) authBtn.click();
        }

        // Custom Headers
        if (config['customHeaders'] && typeof config['customHeaders'] === 'object') {
          const headerList = panel.querySelector('#cm-api-hdr-list');
          headerList.innerHTML = '';
          for (const [key, value] of Object.entries(config['customHeaders'])) {
            const row = document.createElement('div');
            row.className = 'cm-hrow';
            row.innerHTML = `<input name="headerKey" value="${key}"><input name="headerValue" value="${value}"><button class="cm-del-btn" onclick="this.closest('.cm-hrow').remove()">×</button>`;
            headerList.appendChild(row);
          }
        }

        // Request Body
        if (config['requestBody']) {
          const bodyInput = panel.querySelector('textarea[name="requestBody"]');
          if (bodyInput) bodyInput.value = config['requestBody'];
        }
      }

      // Für Manual: Pflichtfelder Button
      if (connId === 'manual' && config['requiredFields']) {
        const requiredBtn = Array.from(panel.querySelectorAll('.cm-field:nth-child(3) .cm-seg-btn'))
          .find(btn => btn.textContent.trim() === config['requiredFields']);
        if (requiredBtn) requiredBtn.click();
      }
    }
  } catch (e) {
    // Fehler beim Laden - stille Behandlung
  }
}

function cmOnConnectorChange(connId) {
  loadConnectorData(connId);
}// ── Load DataSource Configuration ──
async function loadDataSourceConfig(connId) {
  try {
    const dsId = connId.replace('ds-', '');
    const response = await fetch(`${baseUrl}/admin/datasource/${dsId}/config`);
    if (response.ok) {
      const config = await response.json();

      const overviewPanel = document.getElementById(`cm-ov-${connId}`);
      const panel = document.getElementById(`cm-cfg-${connId}`);

      // Fülle Bezeichnung und Status ins Overview-Panel (egal ob Config-Panel existiert)
      if (overviewPanel) {
        const bezInput = overviewPanel.querySelector('input[name="bezeichnung"]');
        const statusInput = overviewPanel.querySelector('input[name="status"]');
        if (bezInput && config.bezeichnung) bezInput.value = config.bezeichnung;
        if (statusInput && config.status) statusInput.value = config.status;
      }

      // Wenn Config-Panel nicht existiert, die restliche Konfiguration nicht laden
      if (!panel) return;

      // Fülle den Typ-Input
      const typeInput = panel.querySelector('input[name="type"]');
      if (typeInput) {
        typeInput.value = config.connectorType === 'api-user' ? 'API' : 'Datenbank';
      }

      // Dynamisch Config-Felder je nach Typ generieren
