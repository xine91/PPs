@{
    ViewData["Title"] = "Connector Manager";
}

<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@300;400;500&display=swap" rel="stylesheet">

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

/* ── Connector Manager Layout ── */
.cm-wrapper { 
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--bg-main);
  color: var(--text-main);
}

.cm-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-main);
}

.cm-header-ico {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
}

.cm-header-txt h1 {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-main);
  margin: 0;
}

.cm-header-txt p {
  font-size: 11px;
  color: var(--text-muted);
  margin: 2px 0 0 0;
  font-family: 'Geist Mono', monospace;
}

.cm-badge {
  margin-left: auto;
  font-size: 10px;
  font-family: 'Geist Mono', monospace;
  padding: 4px 8px;
  border-radius: 6px;
  white-space: nowrap;
  font-weight: 500;
}

.cm-badge.ok { background: #EAF3DE; color: #27500A; }
.cm-badge.warn { background: #FAEEDA; color: #633806; }
.cm-badge.off { background: var(--bg-sidebar); color: var(--text-muted); border: 1px solid var(--border); }

[data-pulse-theme="dark"] .cm-badge.ok { background: #1a2e0a; color: #97C459; }
[data-pulse-theme="dark"] .cm-badge.warn { background: #2c1e05; color: #EF9F27; }

/* ── Connector Selector ── */
.cm-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-main);
  align-content: flex-start;
}

.cm-conn-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s ease-in-out;
  flex-shrink: 0;
  background: transparent;
  color: var(--text-main);
  font-family: inherit;
}

.cm-conn-item:hover {
  border-color: var(--accent);
  background: rgba(51, 133, 98, 0.06);
}

.cm-conn-item.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

.cm-conn-ico {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  flex-shrink: 0;
}

.cm-conn-item .cm-conn-ico {
  background: rgba(51, 133, 98, 0.15);
  color: var(--accent);
}

.cm-conn-item.active .cm-conn-ico {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.ico-tf { background: #E1F5EE !important; color: #085041 !important; }
.ico-api { background: #E6F1FB !important; color: #0C447C !important; }
.ico-sql { background: #FAEEDA !important; color: #633806 !important; }
.ico-man { background: #EEEDFE !important; color: #3C3489 !important; }

[data-pulse-theme="dark"] .ico-tf { background: #04342C !important; color: #5DCAA5 !important; }
[data-pulse-theme="dark"] .ico-api { background: #042C53 !important; color: #85B7EB !important; }
[data-pulse-theme="dark"] .ico-sql { background: #412402 !important; color: #EF9F27 !important; }
[data-pulse-theme="dark"] .ico-man { background: #26215C !important; color: #AFA9EC !important; }

.cm-conn-item.active .ico-tf,
.cm-conn-item.active .ico-api,
.cm-conn-item.active .ico-sql,
.cm-conn-item.active .ico-man {
  background: rgba(255, 255, 255, 0.2) !important;
  color: #fff !important;
}

.cm-conn-name {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-main);
}

.cm-conn-item.active .cm-conn-name {
  color: #fff;
}

.cm-conn-meta {
  font-size: 10px;
  color: var(--text-muted);
  font-family: 'Geist Mono', monospace;
}

.cm-conn-item.active .cm-conn-meta {
  color: rgba(255, 255, 255, 0.8);
}

/* ── Datenquellen Sektion ── */
.cm-datasources-section {
  padding: 0;
  border-bottom: none;
  background: transparent;
  display: contents;
}

.cm-ds-header {
  display: none;
}

.cm-ds-list {
  display: flex;
  flex-direction: row;
  gap: 8px;
  flex-wrap: wrap;
  padding: 8px 20px 0 20px;
}

.cm-ds-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: transparent;
  color: var(--text-main);
  font-size: 11px;
  cursor: pointer;
  transition: all 0.12s;
  flex-shrink: 0;
}

.cm-ds-item:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.cm-ds-item-info {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.cm-ds-item-ico {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  flex-shrink: 0;
}

.cm-ds-item-text {
  flex: 1;
}

.cm-ds-item-name {
  font-weight: 500;
  color: var(--text-main);
}

.cm-ds-item:hover .cm-ds-item-name {
  color: #fff;
}

.cm-ds-item-type {
  font-size: 9px;
  color: var(--text-muted);
  font-family: 'Geist Mono', monospace;
}

.cm-ds-item:hover .cm-ds-item-type {
  color: rgba(255, 255, 255, 0.8);
}

.cm-ds-item-delete {
  padding: 2px 4px;
  border: none;
  background: none;
  color: inherit;
  font-size: 10px;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.12s;
  flex-shrink: 0;
}

.cm-ds-item:hover .cm-ds-item-delete {
  opacity: 1;
  color: #fff;
}
  color: #d64545;
  font-size: 11px;
  cursor: pointer;
  transition: all 0.12s;
  flex-shrink: 0;
}

.cm-ds-item:hover .cm-ds-item-delete {
  color: #fff;
}

.cm-ds-item-delete:hover {
  transform: scale(1.1);
}

/* ── Tabs ── */
.cm-tabs {
  display: flex;
  gap: 0;
  padding: 0 20px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-main);
}

.cm-tab {
  padding: 12px 16px;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  font-size: 11px;
  font-weight: 500;
  font-family: 'Geist Mono', monospace;
  color: var(--text-muted);
  background: none;
  border: none;
  margin: 0;
  transition: all 0.15s ease-in-out;
  text-transform: lowercase;
}

.cm-tab:hover {
  color: var(--text-main);
}

.cm-tab.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
}

/* ── Body & Panels ── */
.cm-body {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
  background: var(--bg-main);
}

.cm-panel {
  display: none;
}

.cm-panel.active {
  display: block;
}

.cm-view {
  display: none;
}

.cm-view.active {
  display: block;
}

/* ── Sections ── */
.cm-sec {
  margin-bottom: 24px;
}

.cm-sec-title {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.cm-sec-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

.cm-sec-hint {
  font-weight: 400;
  opacity: 0.6;
  font-size: 9px;
  text-transform: none;
  letter-spacing: 0.02em;
}

/* ── Form Fields ── */
.cm-field {
  margin-bottom: 12px;
}

.cm-field label {
  font-size: 11px;
  font-weight: 500;
  color: var(--text-main);
  display: block;
  margin-bottom: 4px;
}

.cm-field input,
.cm-field textarea,
.cm-field select {
  width: 100%;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 11px;
  font-family: 'Geist Mono', monospace;
  color: var(--text-main);
  background: transparent;
  transition: border-color 0.12s;
}

.cm-field input:focus,
.cm-field textarea:focus,
.cm-field select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(51, 133, 98, 0.1);
}

.cm-field input[readonly] {
  background: var(--bg-sidebar);
  color: var(--text-muted);
  cursor: not-allowed;
}

.cm-field textarea {
  resize: vertical;
  min-height: 80px;
}

.cm-fields-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

/* ── Locked Field ── */
.cm-locked {
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  background: var(--bg-sidebar);
  font-size: 11px;
}

.cm-locked-side {
  padding: 0 10px;
  border-right: 1px solid var(--border);
  display: flex;
  align-items: center;
  color: var(--text-muted);
}

.cm-locked-txt {
  flex: 1;
  padding: 8px 10px;
  font-size: 10px;
  font-family: 'Geist Mono', monospace;
  color: var(--text-muted);
}

.cm-locked-tag {
  font-size: 9px;
  font-family: 'Geist Mono', monospace;
  padding: 3px 7px;
  margin-right: 8px;
  border-radius: 4px;
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border);
  white-space: nowrap;
}

/* ── Note Box ── */
.cm-note {
  font-size: 10px;
  color: var(--text-main);
  line-height: 1.6;
  padding: 10px 12px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg-sidebar);
  margin-bottom: 12px;
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.cm-note i {
  font-size: 12px;
  color: var(--text-muted);
  flex-shrink: 0;
  margin-top: 2px;
}

/* ── Segmented Control ── */
.cm-seg {
  display: flex;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  width: fit-content;
  margin-bottom: 12px;
  background: var(--bg-sidebar);
}

.cm-seg-btn {
  flex: 1;
  padding: 6px 12px;
  border: none;
  border-right: 1px solid var(--border);
  font-size: 10px;
  font-family: 'Geist Mono', monospace;
  font-weight: 500;
  cursor: pointer;
  background: transparent;
  color: var(--text-muted);
  transition: all 0.12s;
}

.cm-seg-btn:last-child {
  border-right: none;
}

.cm-seg-btn:hover {
  color: var(--accent);
}

.cm-seg-btn.active {
  background: var(--accent);
  color: #fff;
}

/* ── Header Row (für Custom Headers) ── */
.cm-hrow {
  display: grid;
  grid-template-columns: 1fr 1fr 28px;
  gap: 8px;
  margin-bottom: 8px;
  align-items: center;
}

.cm-hrow input {
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 11px;
  font-family: 'Geist Mono', monospace;
  color: var(--text-main);
  background: transparent;
  transition: border-color 0.12s;
}

.cm-hrow input:focus {
  outline: none;
  border-color: var(--accent);
}

.cm-del-btn {
  width: 28px;
  height: 28px;
  padding: 0;
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 16px;
  line-height: 1;
  transition: color 0.12s;
}

.cm-del-btn:hover {
  color: #d64545;
}

/* ── Add Button ── */
.cm-add-btn {
  font-size: 10px;
  font-family: 'Geist Mono', monospace;
  color: var(--text-main);
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  margin-top: 6px;
  transition: color 0.12s;
}

.cm-add-btn:hover {
  color: var(--accent);
}

/* ── Footer Actions ── */
.cm-foot {
  display: flex;
  gap: 8px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
}

/* ── Buttons ── */
.cm-btn {
  padding: 8px 14px;
  font-size: 11px;
  font-weight: 500;
  font-family: inherit;
  border-radius: 6px;
  cursor: pointer;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-main);
  transition: all 0.12s;
}

.cm-btn:hover {
  background: var(--bg-sidebar);
  border-color: var(--border);
}

.cm-btn-primary {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

.cm-btn-primary:hover {
  opacity: 0.85;
  background: var(--accent);
}

.cm-btn-danger {
  color: #d64545;
  border-color: rgba(214, 69, 69, 0.3);
  margin-left: auto;
}

.cm-btn-danger:hover {
  background: rgba(214, 69, 69, 0.08);
}

/* ── Modal Styles ── */
.cm-modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  justify-content: center;
  align-items: center;
  z-index: 10000;
  flex-direction: column;
}

.cm-modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  cursor: pointer;
}

.cm-modal-content {
  position: relative;
  background: var(--bg-main);
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  width: 90%;
  max-width: 500px;
  max-height: 80vh;
  overflow-y: auto;
}

.cm-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.cm-modal-header h2 {
  font-size: 14px;
  font-weight: 600;
  margin: 0;
  color: var(--text-main);
}

.cm-modal-close {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: var(--text-muted);
  padding: 0;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.12s;
}

.cm-modal-close:hover {
  color: var(--text-main);
}

.cm-modal-body {
  padding: 24px 20px;
}

.cm-modal-body p {
  font-size: 12px;
  color: var(--text-muted);
  margin: 0 0 20px 0;
}

.cm-modal-options {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cm-modal-option {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: transparent;
  cursor: pointer;
  transition: all 0.12s;
}

.cm-modal-option:hover {
  background: var(--bg-sidebar);
  border-color: var(--accent);
}

.cm-modal-ico {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  background: rgba(51, 133, 98, 0.1);
  border-radius: 6px;
  color: var(--accent);
  flex-shrink: 0;
}

.cm-modal-txt {
  flex: 1;
  text-align: left;
}

.cm-modal-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-main);
  margin: 0;
}

.cm-modal-desc {
  font-size: 11px;
  color: var(--text-muted);
  margin: 2px 0 0 0;
}

.cm-modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 16px 20px;
  border-top: 1px solid var(--border);
}

</style>

<div class="cm-wrapper">
  <!-- Header -->
  <div class="cm-header">
    <div class="cm-header-ico ico-tf" id="cm-ico"><i class="ti ti-bolt" aria-hidden="true"></i></div>
    <div class="cm-header-txt">
      <h1 id="cm-title">Verbindungen</h1>
      <p id="cm-sub">ERP-Anbindung · Bearer Token · POST</p>
    </div>
    <span class="cm-badge ok" id="cm-badge">verbunden</span>
  </div>
  <div class="cm-tabs">
    <button class="cm-tab" onclick="cmSwTab('config', this)">Einstellungen</button>
    <button class="cm-tab" onclick="cmSwTab('overview', this)">Übersicht</button>
    </div>
  <!-- Connector Selector -->
  <div class="cm-selector">
    <div id="cmDataSourcesList" class="cm-ds-list">
      <!-- Meine Datenquellen werden hier eingefügt -->
    </div>

    <button class="cm-conn-item" onclick="cmOpenAddDataSourceModal()">
      <div class="cm-conn-ico ico-add"><i class="ti ti-plus" aria-hidden="true"></i></div>
      <div>
        <div class="cm-conn-name">Neue Datenquelle</div>
        <div class="cm-conn-meta">+ Erstellen</div>
      </div>
    </button>
  </div>

  <!-- Tabs -->
  

  <!-- Body -->
  <div class="cm-body">

    <!-- OVERVIEW Panel -->
    <div id="cm-tab-overview" class="cm-panel active">

      <div class="cm-view active" id="cm-ov-tf6">
        <div class="cm-sec">
          <div class="cm-sec-title">Allgemein</div>
          <div class="cm-field"><label>Bezeichnung</label><input name="bezeichnung" value="topfact6 Produktion"></div>
          <div class="cm-field"><label>Status</label><input name="status" value="Verbunden · AccessKey aktiv" readonly></div>
          <div class="cm-field"><label>Letzte Synchronisation</label><input value="Heute, 09:14 Uhr" readonly></div>
        </div>
        <div class="cm-foot">
          <button class="cm-btn cm-btn-primary" onclick="cmSaveConnector('tf6')">Speichern</button>
          <button class="cm-btn" onclick="cmTestConnection('tf6')">Verbindung testen</button>
          <button class="cm-btn cm-btn-danger">Entfernen</button>
        </div>
      </div>

      <div class="cm-view" id="cm-ov-api">
        <div class="cm-sec">
          <div class="cm-sec-title">Allgemein</div>
          <div class="cm-field"><label>Bezeichnung</label><input name="bezeichnung" value="Externe Schnittstelle"></div>
          <div class="cm-field"><label>Status</label><input name="status" value="Nicht konfiguriert" readonly></div>
        </div>
        <div class="cm-foot">
          <button class="cm-btn cm-btn-primary" onclick="cmSaveConnector('api')">Speichern</button>
          <button class="cm-btn" onclick="cmTestConnection('api')">Verbindung testen</button>
          <button class="cm-btn cm-btn-danger">Entfernen</button>
        </div>
      </div>

      <div class="cm-view" id="cm-ov-sql">
        <div class="cm-sec">
          <div class="cm-sec-title">Allgemein</div>
          <div class="cm-field"><label>Bezeichnung</label><input name="bezeichnung" value="Produktionsdatenbank"></div>
          <div class="cm-field"><label>Status</label><input name="status" value="Nicht konfiguriert" readonly></div>
        </div>
        <div class="cm-foot">
          <button class="cm-btn cm-btn-primary" onclick="cmSaveConnector('sql')">Speichern</button>
          <button class="cm-btn" onclick="cmTestConnection('sql')">Verbindung testen</button>
          <button class="cm-btn cm-btn-danger">Entfernen</button>
        </div>
      </div>

      <div class="cm-view" id="cm-ov-manual">
        <div class="cm-sec">
          <div class="cm-sec-title">Allgemein</div>
          <div class="cm-field"><label>Bezeichnung</label><input name="bezeichnung" value="Manuelle Eingabe"></div>
          <div class="cm-field"><label>Beschreibung</label><textarea placeholder="Optionale Beschreibung…"></textarea></div>
        </div>
        <div class="cm-foot">
          <button class="cm-btn cm-btn-primary" onclick="cmSaveConnector('manual')">Speichern</button>
        </div>
      </div>

    </div>

    <!-- CONFIG Panel -->
    <div id="cm-tab-config" class="cm-panel">

      <!-- topfact6 Config -->
      <div class="cm-view active" id="cm-cfg-tf6">
        <div class="cm-sec">
          <div class="cm-sec-title">topfact Auth <span class="cm-sec-hint">· Schritt 1 · im Hintergrund</span></div>
          <div class="cm-note">
            <i class="ti ti-info-circle" aria-hidden="true"></i>
            <span>Zugangsdaten des topfact-Website-Logins. Auth läuft vollständig im Backend — der AccessKey ist für den Nutzer nicht sichtbar oder änderbar. Benutzername wird aus Ihrem Login ermittelt.</span>
          </div>
          <div class="cm-field"><label>Auth Endpoint</label><input name="authEndpoint" placeholder="https://auth.topfact.de/api/token"></div>
          <div class="cm-field"><label>Passwort</label><input name="password" type="password" placeholder="••••••••"></div>
        </div>
        <div class="cm-sec">
          <div class="cm-sec-title">topfact6 API <span class="cm-sec-hint">· Schritt 2 · Bearer + Header</span></div>
          <div class="cm-field"><label>API Endpoint</label><input name="apiEndpoint" placeholder="https://api.topfact.de/v6"></div>
          <div class="cm-field">
            <label>AccessKey <span style="font-size: 10px; opacity: 0.6;">(automatisch · nicht editierbar)</span></label>
