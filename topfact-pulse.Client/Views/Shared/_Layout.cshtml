    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@32.2.1/dist/ag-grid-community.min.js"></script>
    <script src="~/js/kategorie-data-loader.js" asp-append-version="true"></script>
    <script>
        (function () {
            const STORAGE_KEY = 'pulse-theme';
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            const btn = document.getElementById('themeToggleBtn');
            const testBtn = document.getElementById('testSaveBtn');

            const applyTheme = theme => {
                html.setAttribute('data-pulse-theme', theme);
                html.setAttribute('data-bs-theme', theme);
                if (icon) {
                    icon.className = theme === 'dark' ? 'ri-moon-line' : 'ri-sun-line';
                }
                localStorage.setItem(STORAGE_KEY, theme);
            };

            const saved = localStorage.getItem(STORAGE_KEY) || 'light';
            if (!localStorage.getItem(STORAGE_KEY)) {
                localStorage.setItem(STORAGE_KEY, 'light');
            }
            applyTheme(saved);

            if (btn) {
                btn.addEventListener('click', () => {
                    const current = html.getAttribute('data-pulse-theme') || 'light';
                    applyTheme(current === 'dark' ? 'light' : 'dark');
                });
            }

            // Test-Button: Daten in DB speichern
            if (testBtn) {
                testBtn.addEventListener('click', async () => {
                    const kategorieId = 4; // Test mit KategorieID = 4
                    const sqlQuery = 'SELECT * FROM Pulse_Kategorie WHERE KategorieID = 4'; // Test-Query
                    const daten = [
                        { KategorieID: 4, Title: 'Test Kategorie 4', IsActive: true }
                    ];

                    try {
                        const response = await fetch('/Home/SaveQueryResult', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                kategorieId: kategorieId,
                                sqlQuery: sqlQuery,
                                daten: daten
                            })
                        });

                        const result = await response.json();
                        if (result.success) {
                            Notiflix.Notify.Success('Daten erfolgreich gespeichert!');
                        } else {
                            Notiflix.Notify.Failure('Fehler beim Speichern: ' + result.message);
                        }
                    } catch (error) {
                        Notiflix.Notify.Failure('Fehler: ' + error.message);
                    }
                });
                    }
                })();
            </script>
