@{
    static string ToSafeId(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "x";
        var chars = input.Where(ch => char.IsLetterOrDigit(ch) || ch == '_' || ch == '-').ToArray();
        return chars.Length == 0 ? "x" : new string(chars);
    }

    // Username + Rollen aus Claims
    var layoutUsername = User.Identity?.Name
        ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? User.FindFirst(ClaimTypes.Email)?.Value
        ?? User.FindFirst("preferred_username")?.Value
        ?? string.Empty;

    // Domain-Präfix (z.B. "DOMAIN\user" ? "user") entfernen,
    // aber E-Mails (z.B. "user@topfact.de") NICHT abschneiden
    if (layoutUsername.Contains('\\'))
        layoutUsername = layoutUsername.Split('\\').Last();

    var layoutRoles = User.Claims
        .Where(c => c.Type == ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();

    // Lade Navigation mit Benutzer-Filterung basierend auf Pulse_Access
    var navigationTree = await PulseNavigationService.GetNavigationTreeForUserAsync(layoutUsername);
    var allModes = navigationTree.Bereiche.ToList();

    // Navigation gefiltert nach Pulse_Access + RequiredRole
    var modes = new List<BereichDto>();
    if (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(layoutUsername))
    {
        try
        {
            // Verwende die allModes direkt (PulseAccessService nicht verfügbar)
            modes = allModes.ToList();

            // Diagnose im HTML-Kommentar (im Browser DevTools sichtbar)
            <text>
            <!-- NAV-DEBUG:
                Username='@layoutUsername',
                Roles=[@string.Join(",", layoutRoles)],
                Bereiche=@modes.Count,
                Alle-Bereiche=@allModes.Count
            -->
            </text>
        }
        catch
        {
            modes = allModes;
        }
    }
    else
    {
        modes = allModes;
    }

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var bereichFromRoute = ViewContext.RouteData.Values["bereich"]?.ToString();

    var firstModeCode = modes.FirstOrDefault()?.Code ?? allModes.FirstOrDefault()?.Code ?? "Technik";

    var matchedMode = modes.FirstOrDefault(x => string.Equals(x.Code, bereichFromRoute, StringComparison.OrdinalIgnoreCase))
        ?? allModes.FirstOrDefault(x => string.Equals(x.Code, bereichFromRoute, StringComparison.OrdinalIgnoreCase));
    var currentBereich = matchedMode?.Code ?? firstModeCode;
}

<body class="app">
    <aside class="app-sidebar">
        <a class="sidebar-brand" href="@Url.Content("~/Home/Dashboard")">
            <img src="~/images/appicon-32.png" alt="logo" />
            <span class="sidebar-brand-text">topfact Pulse</span>
        </a>

        <nav class="app-nav">
            @foreach (var mode in modes)
            {
                // Alle Bereiche anzeigen, auf die der Benutzer Zugriff hat (modes ist bereits gefiltert)
                <div data-nav-mode="@mode.Code">
                    @if (mode.Gruppen.Any())
                    {
                        // Bereichsname als Überschrift oberhalb aller Gruppen
                        <div class="nav-section-label">@mode.DisplayName</div>

                        @foreach (var gruppe in mode.Gruppen)
                        {
                            var collapseId = $"collapse_{ToSafeId(mode.Code)}_{ToSafeId(gruppe.Code)}";
                            var isExpanded = gruppe.IsExpandedDefault;

                            @if (gruppe.IsCollapsible)
                            {
                                <button class="nav-collapse-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isExpanded ? "true" : "false")">
                                    <span>@gruppe.DisplayName</span>
                                    <i class="ri-arrow-down-s-line nav-section-chevron"></i>
                                </button>
                            }

                            <div class="collapse @(isExpanded ? "show" : "")" id="@collapseId" data-collapse-persist="true">
                                @foreach (var item in gruppe.Kategorien)
                                {
                                    <a class="nav-link"
                                       href="@Url.Content("~/kategorie/view/" + item.KategorieID)"
                                       title="@item.Title">
                                        <i class="@item.IconCss nav-icon"></i>
                                        <span>@item.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                                        {
                                            <span class="nav-badge">@item.BadgeText</span>
                                        }
                                    </a>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </nav>
    </aside>

    <header class="app-header">
        <div class="header-search"></div>

        <div class="header-actions d-flex align-items-center gap-3">
            <button id="themeToggleBtn" class="theme-toggle-btn" title="Theme wechseln" aria-label="Theme wechseln">
                <i class="ri-sun-line" id="themeIcon"></i>
            </button>
            
            <a href="#" class="text-muted ui-placeholder-disabled"
            <div class="dropdown">
                <a href="#" data-bs-toggle="dropdown">
                    <img src="@avatarUrl" style="width:32px; height:32px; border-radius:50%; object-fit:cover;" alt="User" onerror="this.src='/images/user-1.jpg'">
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 theme-dropdown">
                    <li><h6 class="dropdown-header text-muted">@User.Identity?.Name</h6></li>
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profil</a></li>
                    @* <li><a class="dropdown-item" asp-controller="Home" asp-action="Settings" asp-route-bereich="@currentBereich">Navigation</a></li> *@
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Abmelden</a></li>
                </ul>
            </div>
        </div>
    </header>

    <div class="app-wrapper">
        <main class="app-content">
             @await Html.PartialAsync("_KategorieDataPanel")
             @RenderBody()
        </main>
        <footer class="app-footer">
            &copy; @DateTime.Now.Year topfact AG &bull; Pulse Cloud Manager
        </footer>
    </div>

