@{
    var bereich = ViewData["Bereich"]?.ToString();
    var placeholderTitle = ViewData["PlaceholderTitle"]?.ToString() ?? "Placeholder";
    ViewData["Title"] = placeholderTitle;
}

<div class="content-card" style="max-width:900px; margin:0 auto; border:1px solid var(--border); border-radius:16px; padding:2rem; background:var(--card-bg); box-shadow:0 10px 30px rgba(0,0,0,0.08);">
    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
        <div style="width:56px; height:56px; border-radius:14px; display:flex; align-items:center; justify-content:center; background:rgba(51,133,98,0.12); color:var(--accent); font-size:1.6rem;">
            <i class="ri-layout-grid-line"></i>
        </div>
        <div>
            <h1 style="margin:0; font-size:1.4rem;">@placeholderTitle</h1>
            <p style="margin:0.35rem 0 0; color:var(--text-muted);">Dieser Bereich ist als Placeholder angelegt und kann jetzt mit Inhalt umgesetzt werden.</p>
        </div>
    </div>

    <div style="display:grid; gap:0.75rem; margin-top:1.5rem;">
        <div class="stat-card" style="--kpi-color:var(--accent);">
            <span class="stat-label">Bereich</span>
            <span class="stat-value">@(string.IsNullOrWhiteSpace(bereich) ? "–" : bereich)</span>
            <span class="stat-sub">Aktueller Navigationskontext</span>
        </div>
    </div>

    <div style="margin-top:1.5rem; padding:1rem 1.25rem; border-radius:12px; border:1px dashed var(--border); color:var(--text-muted);">
        Nächster Schritt: Controller/Action durch Fachlogik ersetzen oder diese Seite als Startpunkt weiter ausbauen.
    </div>
</div>
