@using topfact.Pulse.Models
@model FormRecognizerViewModel

@{
    ViewData["Title"] = "FormRec";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@32.2.1/styles/ag-grid.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@32.2.1/styles/ag-theme-quartz.css" />
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@32.2.1/dist/ag-grid-community.min.js"></script>
    <style>
        :root {
            --bg-page: #0f172a;
            --bg-card: #1e293b;
            --bg-input: #0f1e33;
            --border: #2a3a55;
            --border-subtle: #334155;
            --text-main: #f0f6ff;
            --text-muted: #6b82a8;
            --accent: #338562;
            --accent-hover: #3fa876;
            --accent-glow: rgba(51, 133, 98, 0.25);
        }

        body {
            background-color: var(--bg-page);
            color: var(--text-main);
        }

        .filter-shell {
            background: #1a2640;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 24px 22px;
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }
        .filter-shell::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(51,133,98,0.5), transparent);
        }

        .filter-row {
            display: flex;
            gap: 12px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
            min-width: 130px;
        }

        .filter-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .filter-label svg { opacity: 0.7; flex-shrink: 0; }

        .time-segments {
            display: flex;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 3px;
            gap: 2px;
        }
        .time-seg {
            flex: 1;
            text-align: center;
            padding: 7px 4px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 500;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.18s ease;
            white-space: nowrap;
            user-select: none;
            border: none;
            background: transparent;
        }
        .time-seg:hover { color: var(--text-main); background: rgba(255,255,255,0.04); }
        .time-seg.active {
            background: var(--accent);
            color: #fff;
            font-weight: 600;
        }

        .filter-divider {
            width: 1px;
            height: 38px;
            background: var(--border);
            align-self: flex-end;
            margin-bottom: 1px;
            flex-shrink: 0;
        }

        .date-pair {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .date-input-wrap { position: relative; flex: 1; }
        .date-tag {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            pointer-events: none;
            text-transform: uppercase;
            z-index: 1;
        }
        .filter-date {
            appearance: none;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 9px;
            color: var(--text-main);
            font-size: 13px;
            padding: 9px 10px 9px 34px;
            width: 100%;
            color-scheme: dark;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .filter-date:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        .btn-apply {
            background: var(--accent);
            border: none;
            border-radius: 9px;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            padding: 10px 20px;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.18s ease;
            display: flex;
            align-items: center;
            gap: 7px;
            letter-spacing: 0.01em;
            align-self: flex-end;
        }
        .btn-apply:hover {
            background: var(--accent-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px var(--accent-glow);
        }
        .btn-apply svg { width: 14px; height: 14px; flex-shrink: 0; }

        .stat-card {
            background: #1e293b;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 12px;
            padding: 1rem 1.1rem;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--kpi-color, #475569);
            border-radius: 12px 12px 0 0;
        }
        .stat-label {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
            margin-bottom: 0.35rem;
        }
        .stat-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: #f1f5f9;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .stat-sub {
            font-size: 0.72rem;
            color: #475569;
            margin-top: 0.3rem;
        }

        .content-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 1.25rem;
            margin-bottom: 1.2rem;
        }

        .content-card + .content-card {
            margin-top: 1rem;
        }

        .content-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .card-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            margin: 0;
        }

        .table-search {
            appearance: none;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-main);
            font-size: 13px;
            padding: 7px 12px;
        }
        .table-search:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        .ag-theme-quartz { height: 500px; width: 100%; }
        [data-pulse-theme="dark"] .ag-theme-quartz {
            --ag-background-color: #1e293b;
            --ag-header-background-color: #0f172a;
            --ag-border-color: #334155;
        }
    </style>
}

<form method="post" id="filterForm">
    <input type="hidden" name="selectedDays" id="selectedDaysInput" value="@Model.SelectedDays" />
    <div class="filter-shell">
        <div class="filter-row">
            <div class="filter-group" style="flex: 1.2; min-width: 230px;">
                <span class="filter-label">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 6v6l4 2" />
                    </svg>
                    Zeitraum
                </span>
                <div class="time-segments" id="timeSegs">
                    <button type="button" class="time-seg @(Model.SelectedDays == 7   ? "active" : "")" data-val="7">7 Tage</button>
                    <button type="button" class="time-seg @(Model.SelectedDays == 30  ? "active" : "")" data-val="30">1 Mon.</button>
                    <button type="button" class="time-seg @(Model.SelectedDays == 90  ? "active" : "")" data-val="90">3 Mon.</button>
                    <button type="button" class="time-seg @(Model.SelectedDays == 180 ? "active" : "")" data-val="180">6 Mon.</button>
                    <button type="button" class="time-seg @(Model.SelectedDays == 365 ? "active" : "")" data-val="365">1 Jahr</button>
                </div>
            </div>

            <div class="filter-group" style="flex: 1.5; min-width: 260px;">
                <span class="filter-label">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    Benutzerdefiniert
                </span>
                <div class="date-pair">
                    <div class="date-input-wrap">
                        <span class="date-tag">von</span>
                        <input type="date" id="dateFrom" name="dateFrom" class="filter-date"
                               value="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                    <span style="color:var(--text-muted);font-size:14px;">→</span>
                    <div class="date-input-wrap">
                        <span class="date-tag">bis</span>
                        <input type="date" id="dateTo" name="dateTo" class="filter-date"
                               value="@Model.DateTo?.ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-apply">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                    <polyline points="22 3 21 7 17 6" />
                </svg>
                Laden
            </button>
        </div>
    </div>
</form>

<script>
    (function () {
        var segs = document.querySelectorAll('.time-seg');
        var hiddenInput = document.getElementById('selectedDaysInput');
        var dateFrom = document.getElementById('dateFrom');
        var dateTo = document.getElementById('dateTo');

        segs.forEach(function (seg) {
            seg.addEventListener('click', function () {
                segs.forEach(function (s) { s.classList.remove('active'); });
                seg.classList.add('active');
                hiddenInput.value = seg.dataset.val;
                dateFrom.value = '';
                dateTo.value = '';
            });
        });

        [dateFrom, dateTo].forEach(function (input) {
            input.addEventListener('change', function () {
                if (input.value) {
                    segs.forEach(function (s) { s.classList.remove('active'); });
                    hiddenInput.value = '0';
                }
            });
        });
    })();
</script>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card" style="--kpi-color:#6366f1;">
            <span class="stat-label">Dokumente erkannt</span>
            <span class="stat-value">@Model.TotalDocuments.ToString("N0")</span>
            <span class="stat-sub">Erkannte FormRec-Dokumente</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="--kpi-color:#3b82f6;">
            <span class="stat-label">Aktive Tenants</span>
            <span class="stat-value">@Model.TenantCount.ToString("N0")</span>
            <span class="stat-sub">Tenant-Anzahl im Zeitraum</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="--kpi-color:#22c55e;">
            <span class="stat-label">Ø Dokumente / Tenant</span>
            <span class="stat-value">@Model.AveragePerTenant.ToString("N2")</span>
            <span class="stat-sub">Durchschnitt pro Tenant</span>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <span class="card-title">FormRec Auswertung</span>
        <input type="text" id="grid-search" class="table-search" placeholder="Tenant filtern...">
    </div>
    <div id="formrecGrid" class="ag-theme-quartz"></div>
</div>

@section Scripts {
    <script>
        const statsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats));

        const gridColumnDefs = [
            { field: 'OrgName', headerName: 'Tenant', flex: 2, filter: true },
            { field: 'RecognizedDocuments', headerName: 'Erkannte Dokumente', flex: 1, type: 'numericColumn', valueFormatter: p => formatNumber(p.value) },
            { field: 'Volume', headerName: 'Volumen', flex: 1, type: 'numericColumn', valueFormatter: p => '-' }
        ];

        const gridOptions = {
            columnDefs: gridColumnDefs,
            rowData: statsData,
            defaultColDef: { resizable: true, sortable: true, filter: true },
            pagination: true,
            paginationPageSize: 20,
            animateRows: true,
            localeText: {
                page: 'Seite',
                more: 'mehr',
                to: 'bis',
                of: 'von',
                next: 'Nächste',
                last: 'Letzte',
                first: 'Erste',
                previous: 'Vorherige',
                loadingOoo: 'Lade...',
                pageSizeSelectorLabel: 'Zeilen pro Seite',
                pageSize: 'Zeilen pro Seite',
                pageSizeSelector: 'Zeilen pro Seite',
            },
            onGridReady: (params) => {
                window.gridApi = params.api;
                params.api.sizeColumnsToFit();
            }
        };

        function formatNumber(val) {
            if (val === null || val === undefined) return '0';
            return val.toLocaleString('de-DE');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const gridDiv = document.getElementById('formrecGrid');
            agGrid.createGrid(gridDiv, gridOptions);

            const searchInput = document.getElementById('grid-search');
            searchInput.addEventListener('input', function () {
                if (window.gridApi) {
                    window.gridApi.setGridOption('quickFilterText', this.value);
                }
            });
        });
    </script>
}
