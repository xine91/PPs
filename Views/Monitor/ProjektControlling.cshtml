    [data-pulse-theme="light"] .sb[data-s="active"] { --bb:rgba(217,119,6,.3); --bbg:rgba(217,119,6,.08); --bfg:#d97706; }
    [data-pulse-theme="light"] .sb[data-s="open"]   { --bb:rgba(79,70,229,.3); --bbg:rgba(79,70,229,.06); --bfg:#4f46e5; }
