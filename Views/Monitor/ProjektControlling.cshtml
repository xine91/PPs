    [data-pulse-theme="light"] .err-box { color:#991b1b !important; background:rgba(239,68,68,.07) !important; border-color:rgba(239,68,68,.25) !important; }
    [data-pulse-theme="light"] .empty-box strong { color:#64748b !important; }
    [data-pulse-theme="light"] .empty-box p { color:#94a3b8 !important; }
