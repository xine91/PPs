@section Scripts {
<script>
    const ganttData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Entries.Select(e => new {
            titel = e.Titel, bearbeiter = e.Bearbeiter,
            datum = e.Datum, startdatum = e.Startdatum,
            min   = e.ArbeitszeitMinuten,
        })
    ));

    function tog(secId, chevId) {
        const s = document.getElementById(secId);
        const c = document.getElementById(chevId);
        if (!s) return;
        const isOpen = s.style.display !== 'none';
        s.style.display = isOpen ? 'none' : '';
        c?.classList.toggle('open', !isOpen);
        if (!isOpen && secId === 'ganttSection') {
            const g = document.getElementById('ganttContainer');
            if (g && !g.dataset.r) { renderGantt(g, ganttData); g.dataset.r = '1'; }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const segs = document.querySelectorAll('.tseg');
        const sd   = document.getElementById('sdInput');
        const df   = document.getElementById('dfrom');
        const dt   = document.getElementById('dto');
        const form = document.getElementById('filterForm');
        segs.forEach(s => s.addEventListener('click', () => {
            segs.forEach(x => x.classList.remove('active'));
            s.classList.add('active');
            sd.value = s.dataset.val;
            if (df) df.value = '';
            if (dt) dt.value = '';
            form?.submit();
        }));
        [df, dt].forEach(inp => {
            if (!inp) return;
            inp.addEventListener('change', () => {
                if (inp.value) {
                    segs.forEach(x => x.classList.remove('active'));
                    sd.value = '0';
                    if (df?.value && dt?.value) form?.submit();
                }
            });
        });
    });

    const pd  = v => { if (!v) return null; const d = new Date(v); return isNaN(d)?null:d; };
    const tdk = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    const fdk = k => { const [y,m,d]=k.split('-').map(Number); return new Date(y,(m||1)-1,d||1); };
    const fd  = d => `${String(d.getDate()).padStart(2,'0')}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getFullYear()).slice(-2)}`;
    const esc = v => { const x=document.createElement('div'); x.textContent=v??''; return x.innerHTML; };

    function renderGantt(c, src) {
        const tasks = src.map(e => {
            const s = pd(e.startdatum) || pd(e.datum);
            if (!s) return null;
            return { lbl: e.titel||'—', sub: e.bearbeiter||'—', start: s, min: Number(e.min||0) };
        }).filter(Boolean).sort((a,b)=>a.start-b.start);
        if (!tasks.length) { c.innerHTML='<p style="padding:1rem;color:#2e4a6a;font-size:.77rem">Keine Daten.</p>'; return; }
        const keys  = [...new Set(tasks.map(t=>tdk(t.start)))].sort();
        const days  = keys.map(fdk);
        const idx   = new Map(keys.map((k,i)=>[k,i]));
        const cnt   = days.length;
        const tw    = Math.max(480, cnt*56);
        const sw    = tw/cnt;
        const mx    = Math.max(1, ...tasks.map(t=>t.min));
        const ticks = days.map((d,i)=>{
            if(cnt>14&&i%2!==0) return '';
            if(cnt>28&&i%4!==0) return '';
            return `<span class="g-tick" style="left:${((i+.5)/cnt)*100}%">${fd(d)}</span>`;
        }).join('');
        const rows = tasks.map(t=>{
            const li  = idx.get(tdk(t.start))??0;
            const mw  = Math.max(16,sw*.88);
            const bw  = Math.max(12, 12+(t.min/mx)*(mw-12));
            const bl  = li*sw+(sw-bw)/2;
            return `<div class="g-row">
                      <div><div class="g-lbl" title="${esc(t.lbl)}">${esc(t.lbl)}</div><div class="g-sub">${esc(t.sub)} · ${Math.round(t.min)} min</div></div>
                      <div class="g-track" style="min-width:${tw}px"><div class="g-bar" style="left:${bl}px;width:${bw}px" title="${esc(t.lbl)} — ${esc(t.sub)} — ${t.start.toLocaleDateString()} — ${Math.round(t.min)} min"></div></div>
                    </div>`;
        }).join('');
        c.innerHTML=`<div class="pc-gantt"><div class="g-row" style="margin-bottom:7px"><div></div><div class="g-axis" style="min-width:${tw}px">${ticks}</div></div>${rows}</div>`;
    }
</script>
}
