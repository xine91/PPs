@using topfact.Pulse.Models
@using System.Linq
@model topfact.Pulse.Models.ProjektControllingControllerViewModel

@{
    ViewData["Title"] = "Vorgang Report";

    var firstEntry        = Model.Entries.FirstOrDefault();
    var vorgangTitel      = (string?)ViewBag.VorgangTitel      ?? firstEntry?.Vorgang ?? "Unbekannter Vorgang";
    var vorgangFirma      = (string?)ViewBag.VorgangFirma      ?? firstEntry?.Firma   ?? "—";
    var verantwortlicher  = (string?)ViewBag.Verantwortlicher  ?? "";
    var vorgangNr         = Model.VorgangNummernInput?.Trim()  ?? "—";
    var vorgangStart      = (DateTime?)ViewBag.VorgangStart;
    var vorgangEnde       = (DateTime?)ViewBag.VorgangEnde;
    var planMin           = (decimal)(ViewBag.PlanMinutenGesamt  ?? 0m);
    var bearbeiterStats   = (ViewBag.BearbeiterStats as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var aktionenList      = (ViewBag.AktionenList    as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var istMin            = (decimal)(ViewBag.IstMinutenGesamt   ?? aktionenList.Sum((dynamic a) => (decimal)(a.IstMinuten ?? 0m)));
    var anzahlErledigt    = (int)(ViewBag.AnzahlErledigt         ?? 0);

    var cntTotal  = Model.Entries.Count;
    var cntDone   = Model.Entries.Count(e => GetSKat(e.StatusText) == "done");
    var cntActive = Model.Entries.Count(e => GetSKat(e.StatusText) == "active");
    var cntOpen   = cntTotal - cntDone - cntActive;
    var pct       = cntTotal > 0 ? (int)Math.Round(cntDone * 100.0 / cntTotal) : 0;

    var hasAnyData = cntTotal > 0 || aktionenList.Any();

    var planH     = Math.Round(planMin / 60m, 1);
    var istH      = Math.Round(istMin  / 60m, 1);
    var effizienz = planMin > 0 ? (double)istMin / (double)planMin : 0;
    var deltaH    = Math.Round((istMin - planMin) / 60m, 1);
    var ueber     = deltaH > 0;

    var circumference = 2.0 * Math.PI * 52.0;
    var dash          = circumference * pct / 100.0;

    static string GetSKat(string? s) {
        var t = (s ?? "").ToLowerInvariant();
        if (t.Contains("erledigt") || t.Contains("fertig") || t.Contains("abgeschlossen") || t.Contains("done") || t.Contains("abgerechnet")) return "done";
        if (t.Contains("durchführung") || t.Contains("bearbeitung") || t.Contains("aktiv")) return "active";
        return "open";
    }
    static string Ini(string? n) {
        if (string.IsNullOrWhiteSpace(n)) return "?";
        return string.Join("", n.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    }
    static string FmtH(decimal m) {
        if (m <= 0) return "—";
        if (m < 60) return $"{(int)m} min";
        return $"{Math.Round(m / 60m, 1)} h";
    }
    static string FmtDate(DateTime? d) => d.HasValue ? d.Value.ToString("dd.MM.yyyy") : "—";
}

@section Styles {
<style>
    .pc { display:flex; flex-direction:column; gap:1rem; }

    .fbar { background:#111e30; border:1px solid #1a2d47; border-radius:11px; padding:11px 15px; }
    .frow { display:flex; gap:9px; align-items:flex-end; flex-wrap:wrap; }
    .fg { display:flex; flex-direction:column; gap:4px; flex:1; min-width:110px; }
    .fl { font-size:.6rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#2e4a6a; }
    .tsegs { display:flex; background:#0a1525; border:1px solid #1a2d47; border-radius:7px; padding:2px; gap:2px; }
    .tseg { flex:1; text-align:center; padding:5px 3px; border-radius:5px; font-size:.7rem; font-weight:600; color:#2e4a6a; border:none; background:transparent; cursor:pointer; transition:all .12s; }
    .tseg.active { background:#338562; color:#fff; }
    .tseg:hover:not(.active) { background:rgba(255,255,255,.04); color:#64748b; }
    .dpair { display:flex; gap:5px; align-items:center; }
    .fi { appearance:none; background:#0a1525; border:1px solid #1a2d47; border-radius:7px; color:#c8d8ee; font-size:.77rem; padding:7px 9px; width:100%; color-scheme:dark; outline:none; transition:border .12s; }
    .fi:focus { border-color:#338562; box-shadow:0 0 0 2px rgba(51,133,98,.12); }
    .bload { background:#338562; border:none; border-radius:7px; color:#fff; font-size:.77rem; font-weight:700; padding:8px 15px; cursor:pointer; display:flex; align-items:center; gap:.35rem; white-space:nowrap; transition:background .12s; text-decoration:none; }
    .bload:hover { background:#3fa876; }
    .bback { background:transparent; border:1px solid #1a2d47; border-radius:7px; color:#2e4a6a; font-size:.77rem; font-weight:500; padding:8px 11px; cursor:pointer; display:flex; align-items:center; gap:.35rem; text-decoration:none; transition:all .12s; }
    .bback:hover { border-color:#2e4a6a; color:#64748b; }

    .hero {
        background:#111e30;
        border:1px solid #1a2d47;
        border-radius:16px;
        overflow:hidden;
        position:relative;
    }
    .hero-accent {
        position:absolute; top:0; left:0; right:0; height:2px;
        background:linear-gradient(90deg, transparent 0%, #338562 30%, #3fa876 50%, #338562 70%, transparent 100%);
        background-size:200% 100%;
        animation:accentMove 4s linear infinite;
    }
    @@keyframes accentMove { 0%{background-position:200%} 100%{background-position:-200%} }

    .hero-body {
        display:grid;
        grid-template-columns:1fr auto;
        gap:2rem;
        padding:1.5rem 1.75rem 0;
        align-items:start;
    }
    .hero-eyebrow {
        font-size:.6rem; font-weight:800; letter-spacing:.14em;
        text-transform:uppercase; color:#338562;
        display:flex; align-items:center; gap:.5rem;
        margin-bottom:.45rem;
    }
    .hero-eyebrow::before { content:''; width:18px; height:2px; background:#338562; border-radius:1px; flex-shrink:0; }
    .hero-title {
        font-size:1.45rem; font-weight:800; color:#eaf2ff;
        margin:0 0 .6rem; line-height:1.22; letter-spacing:-.028em;
    }
    .hero-meta { display:flex; flex-wrap:wrap; gap:.85rem; }
    .hmi { display:flex; align-items:center; gap:.38rem; font-size:.77rem; color:#2e4a6a; }
    .hmi i { font-size:.82rem; color:#243a57; }
    .hmi b { color:#5a7a9a; font-weight:600; }

    .hero-ring { display:flex; flex-direction:column; align-items:center; gap:.3rem; padding-top:.2rem; }
    .ring-outer { position:relative; width:120px; height:120px; }
    .ring-outer svg { width:120px; height:120px; transform:rotate(-90deg); }
    .r-bg   { fill:none; stroke:#1a2d47; stroke-width:7; }
    .r-fill { fill:none; stroke:url(#rg); stroke-width:7; stroke-linecap:round; transition:stroke-dasharray .8s cubic-bezier(.4,0,.2,1); }
    .ring-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .ring-pct { font-size:1.6rem; font-weight:800; color:#eaf2ff; letter-spacing:-.04em; line-height:1; }
    .ring-sub { font-size:.56rem; font-weight:700; text-transform:uppercase; letter-spacing:.09em; color:#2e4a6a; margin-top:1px; }

    .hero-statusbar {
        border-top:1px solid #1a2d47;
        margin-top:1.25rem;
        padding:.85rem 1.75rem;
        display:flex; align-items:center; gap:1.2rem; flex-wrap:wrap;
    }
    .sbar-track { flex:1; min-width:180px; }
    .sbar { height:4px; border-radius:2px; background:#0a1525; display:flex; overflow:hidden; }
    .sbar .s-d { background:linear-gradient(90deg,#10b981,#34d399); }
    .sbar .s-a { background:#f59e0b; }
    .sbar .s-o { background:#1e3050; }
    .sbar-legend { display:flex; gap:.9rem; flex-wrap:wrap; }
    .sleg { display:flex; align-items:center; gap:.35rem; font-size:.7rem; color:#2e4a6a; }
    .sleg-dot { width:7px; height:7px; border-radius:50%; }
    .sleg b { color:#5a7a9a; font-weight:700; }

    .row3 { display:grid; grid-template-columns:repeat(3,1fr); gap:.75rem; }
    .pvi-card {
        background:#111e30; border:1px solid #1a2d47;
        border-radius:12px; padding:1rem 1.1rem;
        position:relative; overflow:hidden;
        display:flex; flex-direction:column; gap:.25rem;
    }
    .pvi-card::before { content:''; position:absolute; top:0; left:0; width:3px; bottom:0; background:var(--pc,#1a2d47); border-radius:3px 0 0 3px; }
    .pvi-card[data-p="plan"]   { --pc:#6366f1; }
    .pvi-card[data-p="ist"]    { --pc:#10b981; }
    .pvi-card[data-p="delta"]  { --pc:var(--dc,#1a2d47); }
    .pvi-lbl { font-size:.6rem; font-weight:700; text-transform:uppercase; letter-spacing:.09em; color:#2e4a6a; }
    .pvi-val { font-size:1.5rem; font-weight:800; color:#eaf2ff; letter-spacing:-.03em; line-height:1.1; font-variant-numeric:tabular-nums; }
    .pvi-card[data-p="plan"]  .pvi-val { color:#818cf8; }
    .pvi-card[data-p="ist"]   .pvi-val { color:#10b981; }
    .pvi-eff { display:inline-flex; align-items:center; gap:.3rem; font-size:.68rem; font-weight:700; padding:2px 7px; border-radius:4px; margin-top:.1rem; }
    .pvi-eff.over  { background:rgba(239,68,68,.12);  color:#f87171; }
    .pvi-eff.under { background:rgba(16,185,129,.12); color:#34d399; }
    .pvi-eff.even  { background:rgba(99,102,241,.12); color:#818cf8; }
    .pvi-bar-wrap { margin-top:.4rem; }
    .pvi-bar { height:3px; border-radius:2px; background:#1a2d47; overflow:hidden; }
    .pvi-bar-fill { height:100%; border-radius:2px; background:var(--pc,#338562); }

    .krow {
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(110px,1fr));
        gap:.65rem;
    }
    .kt {
        background:#111e30; border:1px solid #1a2d47;
        border-radius:10px; padding:.75rem .9rem;
        position:relative; overflow:hidden;
    }
    .kt::after { content:''; position:absolute; bottom:0; left:0; right:0; height:2px; background:var(--kc,#1a2d47); }
    .kt[data-k="total"]  { --kc:#338562; }
    .kt[data-k="done"]   { --kc:#10b981; }
    .kt[data-k="active"] { --kc:#f59e0b; }
    .kt[data-k="open"]   { --kc:#6366f1; }
    .kt[data-k="team"]   { --kc:#338562; }
    .kt-lbl { font-size:.58rem; font-weight:700; text-transform:uppercase; letter-spacing:.09em; color:#2e4a6a; margin-bottom:.2rem; }
    .kt-val { font-size:1.4rem; font-weight:800; color:#d8e8f8; letter-spacing:-.03em; line-height:1; font-variant-numeric:tabular-nums; }
    .kt[data-k="done"]   .kt-val { color:#10b981; }
    .kt[data-k="active"] .kt-val { color:#f59e0b; }
    .kt[data-k="open"]   .kt-val { color:#818cf8; }
    .kt-hint { font-size:.62rem; color:#1e3050; margin-top:.15rem; }

    .section-wrap { background:#111e30; border:1px solid #1a2d47; border-radius:13px; overflow:hidden; }
    .section-bar {
        display:flex; justify-content:space-between; align-items:center;
        padding:.8rem 1.1rem; border-bottom:1px solid #1a2d47;
        cursor:pointer; user-select:none; transition:background .1s;
    }
    .section-bar:hover { background:rgba(255,255,255,.012); }
    .sbl { display:flex; align-items:center; gap:.65rem; }
    .sicon { width:26px; height:26px; border-radius:6px; background:rgba(51,133,98,.1); display:flex; align-items:center; justify-content:center; }
    .sicon i { font-size:.85rem; color:#338562; }
    .slbl { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#3d5a80; }
    .sbadge { font-size:.62rem; font-weight:700; padding:2px 6px; border-radius:4px; background:rgba(255,255,255,.04); color:#2e4a6a; }
    .schev { font-size:.95rem; color:#1e3050; transition:transform .18s; }
    .schev.open { transform:rotate(180deg); }

    .b-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:.75rem; padding:1rem 1.1rem; }
    .b-card {
        background:#0d1a2b; border:1px solid #1a2d47;
        border-radius:11px; padding:1rem 1.1rem;
        transition:border-color .15s, box-shadow .15s;
    }
    .b-card:hover { border-color:#243a57; box-shadow:0 4px 20px rgba(0,0,0,.25); }
    .b-head { display:flex; align-items:center; gap:.75rem; margin-bottom:.85rem; }
    .b-avatar {
        width:36px; height:36px; border-radius:50%;
        background:linear-gradient(135deg,#338562,#2a6e50);
        color:#fff; font-size:.68rem; font-weight:800;
        display:flex; align-items:center; justify-content:center;
        flex-shrink:0; letter-spacing:0;
    }
    .b-name { font-size:.85rem; font-weight:700; color:#c8d8ee; line-height:1.2; }
    .b-role { font-size:.68rem; color:#2e4a6a; margin-top:1px; }
    .b-stats { display:grid; grid-template-columns:1fr 1fr 1fr; gap:.5rem; margin-bottom:.85rem; }
    .b-stat-item { display:flex; flex-direction:column; gap:2px; }
    .b-stat-lbl { font-size:.58rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#1e3050; }
    .b-stat-val { font-size:.98rem; font-weight:800; color:#8aa0bc; font-variant-numeric:tabular-nums; }
    .b-stat-val.plan  { color:#818cf8; }
    .b-stat-val.ist   { color:#10b981; }
    .b-stat-val.erl   { color:#10b981; }
    .b-progress { display:flex; flex-direction:column; gap:.3rem; }
    .b-pbar { height:3px; border-radius:2px; background:#1a2d47; overflow:hidden; }
    .b-pbar-fill { height:100%; border-radius:2px; background:linear-gradient(90deg,#10b981,#34d399); }
    .b-plbl { display:flex; justify-content:space-between; font-size:.62rem; color:#1e3050; }
    .b-plbl span { color:#2e4a6a; }
    .b-delta {
        display:inline-flex; align-items:center; gap:.25rem;
        font-size:.65rem; font-weight:700; padding:2px 7px;
        border-radius:4px; margin-top:.3rem; align-self:flex-start;
    }
    .b-delta.over  { background:rgba(239,68,68,.1);  color:#f87171; }
    .b-delta.under { background:rgba(16,185,129,.1); color:#34d399; }
    .b-delta.even  { background:rgba(99,102,241,.08); color:#818cf8; }

    .ak-table { width:100%; border-collapse:collapse; }
    .ak-table th { font-size:.58rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#1e3050; padding:.55rem 1rem; text-align:left; border-bottom:1px solid #0f1d2e; background:#0a1525; }
    .ak-table td { padding:.7rem 1rem; border-bottom:1px solid #0f1d2e; vertical-align:middle; font-size:.8rem; color:#8aa0bc; }
    .ak-table tbody tr:last-child td { border-bottom:none; }
    .ak-table tbody tr:hover td { background:rgba(255,255,255,.015); }
    .sb { display:inline-flex; align-items:center; gap:4px; font-size:.65rem; font-weight:700; padding:2px 8px; border-radius:4px; border:1px solid var(--bb); background:var(--bbg); color:var(--bfg); white-space:nowrap; }
    .sb .sd { width:5px; height:5px; border-radius:50%; background:var(--bfg); flex-shrink:0; }
    .sb[data-s="done"]   { --bb:rgba(16,185,129,.3); --bbg:rgba(16,185,129,.1);  --bfg:#10b981; }
    .sb[data-s="active"] { --bb:rgba(245,158,11,.3); --bbg:rgba(245,158,11,.1);  --bfg:#f59e0b; }
    .sb[data-s="open"]   { --bb:rgba(99,102,241,.3); --bbg:rgba(99,102,241,.08); --bfg:#818cf8; }
    .sb[data-s="other"]  { --bb:rgba(30,48,80,.6);   --bbg:rgba(30,48,80,.3);    --bfg:#3d5a80; }
    .tba { display:flex; align-items:center; gap:.4rem; }
    .tba-av { width:20px; height:20px; border-radius:50%; background:#338562; color:#fff; font-size:.55rem; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .tnr { font-family:ui-monospace,"SF Mono",Consolas,monospace; font-size:.68rem; color:#1e3050; }

    .empty-box { display:flex; flex-direction:column; align-items:center; padding:3rem 2rem; gap:.75rem; }
    .empty-box i { font-size:2rem; color:#1a2d47; }
    .empty-box strong { font-size:.85rem; color:#2e4a6a; }
    .empty-box p { font-size:.77rem; color:#1e3050; text-align:center; margin:0; line-height:1.6; }

    .gantt-wrap { padding:1rem 1.1rem; overflow-x:auto; }
    .g-row { display:grid; grid-template-columns:210px 1fr; gap:12px; align-items:center; min-height:42px; margin-bottom:7px; }
    .g-lbl { color:#8aa0bc; font-size:.77rem; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .g-sub { color:#1e3050; font-size:.68rem; margin-top:1px; }
    .g-axis { position:relative; height:26px; border-radius:6px; background:rgba(255,255,255,.03); }
    .g-tick { position:absolute; transform:translateX(-50%); top:4px; color:#2e4a6a; font-size:.64rem; font-weight:600; white-space:nowrap; background:rgba(10,21,37,.88); padding:0 4px; border-radius:3px; z-index:2; }
    .g-track { position:relative; min-height:28px; border-radius:6px; background:rgba(255,255,255,.025); }
    .g-bar { position:absolute; top:3px; height:22px; border-radius:5px; background:linear-gradient(90deg,#338562,#3fa876); box-shadow:0 2px 8px rgba(51,133,98,.2); min-width:12px; cursor:pointer; transition:filter .12s; }
    .g-bar:hover { filter:brightness(1.25) drop-shadow(0 0 5px #3fa876aa); }

    .err-box { background:rgba(239,68,68,.1); border:1px solid rgba(239,68,68,.3); color:#f87171; border-radius:10px; padding:.75rem 1rem; font-size:.8rem; }

